sort [g asc nulls-last, s asc]
└─ project (g, s) (rows≈2 cost≈380)
   └─ filter (|| (call qdb_is_null |t.a|) (> |t.a| 1)) (rows≈2 cost≈348)
      └─ aggregate keys=[t.a] aggs=[sum_0=sum] (rows≈3 cost≈288)
         └─ project (t.a, t.b) (rows≈4 cost≈128)
            └─ source t AS t (rows≈4 cost≈64)
