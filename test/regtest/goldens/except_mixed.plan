(rel join
  (rel aggregate (rel project (rel source "t" "t") (a |t.a|)) (keys a))
  (rel aggregate
    (rel join
      (rel aggregate (rel project (rel source "s" "s") (a |s.a|)) (keys a))
      (rel aggregate (rel project (rel source "u" "u") (a |u.a|)) (keys a))
      ((a a nulls_equal))
      (left_semi))
    (keys a))
  ((a a nulls_equal))
  (left_anti))
