(rel project
  (rel aggregate
    (rel project
      (rel source "t" "t")
      (arg_0 (cast |t.v| f64))
      (arg_1 (* (cast |t.v| f64) (cast |t.v| f64)))
      (|t.v| |t.v|)
      (__group__ 1))
    (keys __group__)
    (agg sum_0 sum arg_0)
    (agg sum_1 sum arg_1)
    (agg count_0 count |t.v|))
  (s (if
      (< count_0 2)
      (call qdb_sql_null)
      (call qdb_sqrt (/ (- sum_1 (/ (* sum_0 sum_0) (cast count_0 f64))) (- (cast count_0 f64) 1.0))))))
