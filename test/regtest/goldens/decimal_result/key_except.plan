sort [k asc]
└─ project (k, a) (rows≈2 cost≈5.1K)
   └─ join left_anti [__join_key_0__ IS NOT DISTINCT FROM col0, __join_key_1__ IS NOT DISTINCT FROM col1] (rows≈2 cost≈5.1K)
      ├─ project (k, a, __join_key_0__, __join_key_1__) (rows≈5 cost≈480)
      │  └─ project (k, a, __join_key_0__) (rows≈5 cost≈300)
      │     └─ project (k, a) (rows≈5 cost≈200)
      │        └─ aggregate keys=[k, a] (rows≈5 cost≈140)
      │           └─ project (k, a) (rows≈5 cost≈80)
      │              └─ source t AS t (rows≈5 cost≈20)
      └─ project (col0, col1) (rows≈3 cost≈256)
         └─ aggregate keys=[col0, col1] (rows≈3 cost≈184)
            └─ project (col0, col1) (rows≈3 cost≈112)
               └─ filter (> |t_1.id| 2) (rows≈3 cost≈40)
                  └─ source t AS t_1 row-groups (> |t_1.id| 2) (rows≈5 cost≈20)
