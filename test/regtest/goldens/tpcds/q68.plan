top-sort [c_last_name asc, ss_ticket_number asc] limit 100
└─ project (c_last_name, c_first_name, ca_city, bought_city, ss_ticket_number, extended_price, extended_tax, list_price) (rows≈1 cost≈27.8K)
   └─ join inner [current_addr.ca_address_sk = customer.c_current_addr_sk] emit-filter 1 from right residual (!= |current_addr.ca_city| |dn.bought_city|) (rows≈1 cost≈27.7K)
      ├─ source customer_address AS current_addr use-filter 1 keys=[current_addr.ca_address_sk] (rows≈10 cost≈200)
      └─ join inner [customer.c_customer_sk = dn.ss_customer_sk] emit-filter 2 from right (rows≈1 cost≈23.3K)
         ├─ source customer AS customer use-filter 2 keys=[customer.c_customer_sk] (rows≈10 cost≈400)
         └─ project (dn.ss_ticket_number, dn.ss_customer_sk, dn.bought_city, dn.extended_price, dn.list_price, dn.extended_tax) (rows≈1 cost≈18.6K)
            └─ project (ss_ticket_number, ss_customer_sk, bought_city, extended_price, list_price, extended_tax) (rows≈1 cost≈18.6K)
               └─ aggregate keys=[store_sales.ss_ticket_number, store_sales.ss_customer_sk, store_sales.ss_addr_sk, customer_address.ca_city] aggs=[sum_0=sum, sum_1=sum, sum_2=sum] (rows≈1 cost≈18.5K)
                  └─ join inner [customer_address.ca_address_sk = store_sales.ss_addr_sk] emit-filter 3 from right (rows≈1 cost≈18.5K)
                     ├─ source customer_address AS customer_address use-filter 3 keys=[customer_address.ca_address_sk] (rows≈10 cost≈200)
                     └─ join inner [store_sales.ss_store_sk = store.s_store_sk] (rows≈1 cost≈14K)
                        ├─ join inner [household_demographics.hd_demo_sk = store_sales.ss_hdemo_sk] (rows≈1 cost≈9.4K)
                        │  ├─ filter (|| (== |household_demographics.hd_dep_count| 5) (== |household_demographics.hd_vehicle_count| 3)) (rows≈5 cost≈240)
                        │  │  └─ source household_demographics AS household_demographics row-groups (|| (== |household_demographics.hd_dep_count| 5) (== |household_demographics.hd_vehicle_count| 3)) (rows≈10 cost≈120)
                        │  └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈2 cost≈5K)
                        │     ├─ filter (&& (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 2)) (call qdb_in_list |date_dim.d_year| 1999 (+ 1999 1) (+ 1999 2))) (rows≈2 cost≈240)
                        │     │  └─ source date_dim AS date_dim row-groups (&& (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 2)) (call qdb_in_list |date_dim.d_year| 1999 (+ 1999 1) (+ 1999 2))) (rows≈10 cost≈120)
                        │     └─ source store_sales AS store_sales (rows≈10 cost≈480)
                        └─ filter (call qdb_in_list |store.s_city| (cast "Midway" <named StringView>) (cast "Fairview" <named StringView>)) (rows≈5 cost≈400)
                           └─ source store AS store row-groups (call qdb_in_list |store.s_city| (cast "Midway" <named StringView>) (cast "Fairview" <named StringView>)) (rows≈10 cost≈200)
