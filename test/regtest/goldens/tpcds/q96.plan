top-sort [col0 asc] limit 100
└─ project (col0) (rows≈1 cost≈13.4K)
   └─ aggregate keys=[__group__] aggs=[count_0=count] (rows≈1 cost≈13.4K)
      └─ project (__group__) (rows≈1 cost≈13.4K)
         └─ join inner [store_sales.ss_hdemo_sk = household_demographics.hd_demo_sk] (rows≈1 cost≈13.4K)
            ├─ join inner [store_sales.ss_sold_time_sk = time_dim.t_time_sk] (rows≈1 cost≈9.1K)
            │  ├─ join inner [store.s_store_sk = store_sales.ss_store_sk] (rows≈1 cost≈4.7K)
            │  │  ├─ filter (== |store.s_store_name| (cast "ese" <named StringView>)) (rows≈1 cost≈400)
            │  │  │  └─ source store AS store row-groups (== |store.s_store_name| (cast "ese" <named StringView>)) (rows≈10 cost≈200)
            │  │  └─ source store_sales AS store_sales (rows≈10 cost≈120)
            │  └─ filter (&& (== |time_dim.t_hour| 8) (>= |time_dim.t_minute| 30)) (rows≈1 cost≈240)
            │     └─ source time_dim AS time_dim row-groups (&& (== |time_dim.t_hour| 8) (>= |time_dim.t_minute| 30)) (rows≈10 cost≈120)
            └─ filter (== |household_demographics.hd_dep_count| 5) (rows≈1 cost≈160)
               └─ source household_demographics AS household_demographics row-groups (== |household_demographics.hd_dep_count| 5) (rows≈10 cost≈80)
