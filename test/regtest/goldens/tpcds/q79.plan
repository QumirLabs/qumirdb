top-sort [c_last_name asc, c_first_name asc, col2 asc, profit asc] limit 100
└─ project (c_last_name, c_first_name, col2, ss_ticket_number, amt, profit) (rows≈1 cost≈18.7K)
   └─ join inner [customer.c_customer_sk = ms.ss_customer_sk] emit-filter 1 from right (rows≈1 cost≈18.6K)
      ├─ source customer AS customer use-filter 1 keys=[customer.c_customer_sk] (rows≈10 cost≈360)
      └─ project (ms.ss_ticket_number, ms.ss_customer_sk, ms.s_city, ms.amt, ms.profit) (rows≈1 cost≈14.1K)
         └─ project (ss_ticket_number, ss_customer_sk, s_city, amt, profit) (rows≈1 cost≈14K)
            └─ aggregate keys=[store_sales.ss_ticket_number, store_sales.ss_customer_sk, store_sales.ss_addr_sk, store.s_city] aggs=[sum_0=sum, sum_1=sum] (rows≈1 cost≈14K)
               └─ join inner [household_demographics.hd_demo_sk = store_sales.ss_hdemo_sk] (rows≈1 cost≈13.9K)
                  ├─ filter (|| (== |household_demographics.hd_dep_count| 8) (> |household_demographics.hd_vehicle_count| 0)) (rows≈5 cost≈240)
                  │  └─ source household_demographics AS household_demographics row-groups (|| (== |household_demographics.hd_dep_count| 8) (> |household_demographics.hd_vehicle_count| 0)) (rows≈10 cost≈120)
                  └─ join inner [store.s_store_sk = store_sales.ss_store_sk] (rows≈1 cost≈9.5K)
                     ├─ filter (&& (<= 200 |store.s_number_employees|) (<= |store.s_number_employees| 295)) (rows≈2 cost≈480)
                     │  └─ source store AS store row-groups (&& (<= 200 |store.s_number_employees|) (<= |store.s_number_employees| 295)) (rows≈10 cost≈240)
                     └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.8K)
                        ├─ filter (&& (== |date_dim.d_dow| 1) (call qdb_in_list |date_dim.d_year| 1998 (+ 1998 1) (+ 1998 2))) (rows≈1 cost≈240)
                        │  └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_dow| 1) (call qdb_in_list |date_dim.d_year| 1998 (+ 1998 1) (+ 1998 2))) (rows≈10 cost≈120)
                        └─ source store_sales AS store_sales (rows≈10 cost≈400)
