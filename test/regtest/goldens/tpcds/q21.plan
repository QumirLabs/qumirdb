top-sort [w_warehouse_name asc, i_item_id asc] limit 100
└─ project (w_warehouse_name, i_item_id, inv_before, inv_after) (rows≈1 cost≈13.9K)
   └─ project (x.w_warehouse_name, x.i_item_id, x.inv_before, x.inv_after) (rows≈1 cost≈13.8K)
      └─ filter (&& (<= (/ 2.0 3.0) (if (call qdb_is_true (> sum_0 0)) (/ sum_1 sum_0) (call qdb_sql_null))) (<= (if (call qdb_is_true (> sum_0 0)) (/ sum_1 sum_0) (call qdb_sql_null)) (/ 3.0 2.0))) (rows≈1 cost≈13.8K)
         └─ aggregate keys=[w_warehouse_name, i_item_id] aggs=[sum_0=sum, sum_1=sum] (rows≈1 cost≈13.7K)
            └─ project (w_warehouse_name, i_item_id, arg_0, arg_1) (rows≈1 cost≈13.7K)
               └─ join inner [inventory.inv_warehouse_sk = warehouse.w_warehouse_sk] emit-filter 1 from left (rows≈1 cost≈13.6K)
                  ├─ join inner [inventory.inv_item_sk = item.i_item_sk] (rows≈1 cost≈9.2K)
                  │  ├─ join inner [date_dim.d_date_sk = inventory.inv_date_sk] (rows≈1 cost≈4.5K)
                  │  │  ├─ filter (&& (<= (- (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈1 cost≈160)
                  │  │  │  └─ source date_dim AS date_dim row-groups (&& (<= (- (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈10 cost≈80)
                  │  │  └─ source inventory AS inventory (rows≈10 cost≈160)
                  │  └─ filter (&& (<= 0.98999999999999999 |item.i_current_price|) (<= |item.i_current_price| 1.49)) (rows≈2 cost≈560)
                  │     └─ source item AS item row-groups (&& (<= 0.98999999999999999 |item.i_current_price|) (<= |item.i_current_price| 1.49)) (rows≈10 cost≈280)
                  └─ source warehouse AS warehouse use-filter 1 keys=[warehouse.w_warehouse_sk] (rows≈10 cost≈200)
