top-sort [s_store_name asc, i_item_desc asc] limit 100
└─ project (s_store_name, i_item_desc, revenue, i_current_price, i_wholesale_cost, i_brand) (rows≈1 cost≈22.6K)
   └─ join inner [sb.ss_store_sk = store.s_store_sk] emit-filter 1 from left (rows≈1 cost≈22.5K)
      ├─ join inner [sc.ss_store_sk = sb.ss_store_sk] residual (<= |sc.revenue| (* 0.10000000000000001 |sb.ave|)) (rows≈1 cost≈18.1K)
      │  ├─ join inner [sc.ss_item_sk = item.i_item_sk] emit-filter 2 from left (rows≈1 cost≈9.3K)
      │  │  ├─ project (sc.ss_store_sk, sc.ss_item_sk, sc.revenue) (rows≈1 cost≈4.6K)
      │  │  │  └─ aggregate keys=[store_sales_1.ss_store_sk, store_sales_1.ss_item_sk] aggs=[sum_0=sum] (rows≈1 cost≈4.5K)
      │  │  │     └─ join inner [date_dim_1.d_date_sk = store_sales_1.ss_sold_date_sk] (rows≈1 cost≈4.5K)
      │  │  │        ├─ filter (&& (<= 1212 |date_dim_1.d_month_seq|) (<= |date_dim_1.d_month_seq| (+ 1212 11))) (rows≈2 cost≈160)
      │  │  │        │  └─ source date_dim AS date_dim_1 row-groups (&& (<= 1212 |date_dim_1.d_month_seq|) (<= |date_dim_1.d_month_seq| (+ 1212 11))) (rows≈10 cost≈80)
      │  │  │        └─ source store_sales AS store_sales_1 (rows≈10 cost≈200)
      │  │  └─ source item AS item use-filter 2 keys=[item.i_item_sk] (rows≈10 cost≈520)
      │  └─ project (sb.ss_store_sk, sb.ave) (rows≈1 cost≈4.6K)
      │     └─ aggregate keys=[sa.ss_store_sk] aggs=[sum_0=sum, count_0=count] (rows≈1 cost≈4.6K)
      │        └─ project (sa.ss_store_sk, sa.revenue) (rows≈1 cost≈4.6K)
      │           └─ aggregate keys=[store_sales.ss_store_sk, store_sales.ss_item_sk] aggs=[sum_0=sum] (rows≈1 cost≈4.5K)
      │              └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.5K)
      │                 ├─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈2 cost≈160)
      │                 │  └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈80)
      │                 └─ source store_sales AS store_sales (rows≈10 cost≈200)
      └─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈200)
