top-sort [ca_state asc, cd_gender asc, cd_marital_status asc, cd_dep_count asc, cd_dep_employed_count asc, cd_dep_college_count asc] limit 100
└─ project (ca_state, cd_gender, cd_marital_status, cd_dep_count, cnt1, aggone1, aggtwo1, aggthree1, cd_dep_employed_count, cnt2, aggone2, aggtwo2, aggthree2, cd_dep_college_count, cnt3, aggone3, aggtwo3, aggthree3) (rows≈1 cost≈31.8K)
   └─ aggregate keys=[ca.ca_state, customer_demographics.cd_gender, customer_demographics.cd_marital_status, customer_demographics.cd_dep_count, customer_demographics.cd_dep_employed_count, customer_demographics.cd_dep_college_count] aggs=[count_0=count, sum_0=sum, count_1=count, max_0=max, sum_1=sum, count_2=count, max_1=max, sum_2=sum, count_3=count, max_2=max] (rows≈1 cost≈31.6K)
      └─ join left_semi [c.c_customer_sk = __exists_key__] (rows≈1 cost≈31.5K)
         ├─ join inner [customer_demographics.cd_demo_sk = c.c_current_cdemo_sk] emit-filter 1 from right (rows≈1 cost≈17.9K)
         │  ├─ source customer_demographics AS customer_demographics use-filter 1 keys=[customer_demographics.cd_demo_sk] (rows≈10 cost≈480)
         │  └─ join inner [ca.ca_address_sk = c.c_current_addr_sk] emit-filter 2 from right (rows≈1 cost≈13.2K)
         │     ├─ source customer_address AS ca use-filter 2 keys=[ca.ca_address_sk] (rows≈10 cost≈200)
         │     └─ join left_semi [c.c_customer_sk = store_sales.ss_customer_sk] (rows≈1 cost≈8.9K)
         │        ├─ source customer AS c (rows≈10 cost≈120)
         │        └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] (rows≈5 cost≈4.6K)
         │           ├─ source store_sales AS store_sales (rows≈10 cost≈80)
         │           └─ filter (&& (== |date_dim.d_year| 1999) (< |date_dim.d_qoy| 4)) (rows≈5 cost≈240)
         │              └─ source date_dim AS date_dim row-groups (&& (< |date_dim.d_qoy| 4) (== |date_dim.d_year| 1999)) (rows≈10 cost≈120)
         └─ union-all (rows≈10 cost≈9.4K)
            ├─ project (__exists_key__) (rows≈5 cost≈4.7K)
            │  └─ join inner [date_dim_1.d_date_sk = web_sales.ws_sold_date_sk] (rows≈5 cost≈4.7K)
            │     ├─ filter (&& (== |date_dim_1.d_year| 1999) (< |date_dim_1.d_qoy| 4)) (rows≈5 cost≈240)
            │     │  └─ source date_dim AS date_dim_1 row-groups (&& (< |date_dim_1.d_qoy| 4) (== |date_dim_1.d_year| 1999)) (rows≈10 cost≈120)
            │     └─ filter (! (call qdb_is_null |web_sales.ws_bill_customer_sk|)) (rows≈10 cost≈160)
            │        └─ source web_sales AS web_sales row-groups (! (call qdb_is_null |web_sales.ws_bill_customer_sk|)) (rows≈10 cost≈80)
            └─ project (__exists_key__) (rows≈5 cost≈4.7K)
               └─ join inner [date_dim_2.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈5 cost≈4.7K)
                  ├─ filter (&& (== |date_dim_2.d_year| 1999) (< |date_dim_2.d_qoy| 4)) (rows≈5 cost≈240)
                  │  └─ source date_dim AS date_dim_2 row-groups (&& (< |date_dim_2.d_qoy| 4) (== |date_dim_2.d_year| 1999)) (rows≈10 cost≈120)
                  └─ filter (! (call qdb_is_null |catalog_sales.cs_ship_customer_sk|)) (rows≈10 cost≈160)
                     └─ source catalog_sales AS catalog_sales row-groups (! (call qdb_is_null |catalog_sales.cs_ship_customer_sk|)) (rows≈10 cost≈80)
