top-sort [i_item_id asc, i_item_desc asc, s_state asc] limit 100
└─ project (i_item_id, i_item_desc, s_state, store_sales_quantitycount, store_sales_quantityave, store_sales_quantitystdev, store_sales_quantitycov, store_returns_quantitycount, store_returns_quantityave, store_returns_quantitystdev, store_returns_quantitycov, catalog_sales_quantitycount, catalog_sales_quantityave, catalog_sales_quantitystdev, catalog_sales_quantitycov) (rows≈1 cost≈32.4K)
   └─ aggregate keys=[item.i_item_id, item.i_item_desc, store.s_state] aggs=[count_0=count, sum_0=sum, sum_1=sum, sum_2=sum, count_1=count, sum_3=sum, sum_4=sum, count_2=count, count_3=count, sum_5=sum, sum_6=sum, sum_7=sum, count_4=count, sum_8=sum, sum_9=sum, count_5=count, count_6=count, sum_10=sum, sum_11=sum, sum_12=sum, count_7=count, sum_13=sum, sum_14=sum, count_8=count] (rows≈1 cost≈32.3K)
      └─ project (item.i_item_id, item.i_item_desc, store.s_state, store_sales.ss_quantity, arg_0, arg_1, store_returns.sr_return_quantity, arg_2, arg_3, catalog_sales.cs_quantity, arg_4, arg_5) (rows≈1 cost≈32K)
         └─ join inner [item.i_item_sk = store_returns.sr_item_sk, store_sales.ss_customer_sk = store_returns.sr_customer_sk, store_sales.ss_ticket_number = store_returns.sr_ticket_number] (rows≈1 cost≈31.9K)
            ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 1 from right (rows≈1 cost≈13.9K)
            │  ├─ source item AS item use-filter 1 keys=[item.i_item_sk] (rows≈10 cost≈360)
            │  └─ join inner [store.s_store_sk = store_sales.ss_store_sk] emit-filter 2 from right (rows≈1 cost≈9.3K)
            │     ├─ source store AS store use-filter 2 keys=[store.s_store_sk] (rows≈10 cost≈200)
            │     └─ join inner [d1.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.9K)
            │        ├─ filter (== |d1.d_quarter_name| (cast "1998Q1" <named StringView>)) (rows≈10 cost≈400)
            │        │  └─ source date_dim AS d1 row-groups (== |d1.d_quarter_name| (cast "1998Q1" <named StringView>)) (rows≈10 cost≈200)
            │        └─ source store_sales AS store_sales (rows≈10 cost≈240)
            └─ join inner [catalog_sales.cs_item_sk = store_returns.sr_item_sk, catalog_sales.cs_bill_customer_sk = store_returns.sr_customer_sk] (rows≈1 cost≈13.8K)
               ├─ join inner [d3.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈1 cost≈4.8K)
               │  ├─ filter (call qdb_in_list |d3.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈400)
               │  │  └─ source date_dim AS d3 row-groups (call qdb_in_list |d3.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈200)
               │  └─ source catalog_sales AS catalog_sales (rows≈10 cost≈160)
               └─ join inner [d2.d_date_sk = store_returns.sr_returned_date_sk] (rows≈1 cost≈4.8K)
                  ├─ filter (call qdb_in_list |d2.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈400)
                  │  └─ source date_dim AS d2 row-groups (call qdb_in_list |d2.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈200)
                  └─ source store_returns AS store_returns (rows≈10 cost≈200)
