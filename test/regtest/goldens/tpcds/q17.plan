top-sort [i_item_id asc, i_item_desc asc, s_state asc] limit 100
└─ project (i_item_id, i_item_desc, s_state, store_sales_quantitycount, store_sales_quantityave, store_sales_quantitystdev, store_sales_quantitycov, store_returns_quantitycount, store_returns_quantityave, store_returns_quantitystdev, store_returns_quantitycov, catalog_sales_quantitycount, catalog_sales_quantityave, catalog_sales_quantitystdev, catalog_sales_quantitycov) (rows≈1 cost≈32.8K)
   └─ aggregate keys=[i_item_id, i_item_desc, s_state] aggs=[count_0=count, sum_1=sum, sum_2=sum, sum_3=sum, count_4=count, sum_5=sum, sum_6=sum, count_7=count, count_8=count, sum_9=sum, sum_10=sum, sum_11=sum, count_12=count, sum_13=sum, sum_14=sum, count_15=count, count_16=count, sum_17=sum, sum_18=sum, sum_19=sum, count_20=count, sum_21=sum, sum_22=sum, count_23=count] (rows≈1 cost≈32.7K)
      └─ project (i_item_id, i_item_desc, s_state, ss_quantity, arg_0, arg_1, arg_2, arg_3, sr_return_quantity, arg_4, arg_5, arg_6, arg_7, cs_quantity, arg_8, arg_9, arg_10, arg_11) (rows≈1 cost≈32.5K)
         └─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 1 from right (rows≈1 cost≈32.3K)
            ├─ source item AS item use-filter 1 keys=[item.i_item_sk] (rows≈10 cost≈360)
            └─ join inner [store.s_store_sk = store_sales.ss_store_sk] emit-filter 2 from right (rows≈1 cost≈27.6K)
               ├─ source store AS store use-filter 2 keys=[store.s_store_sk] (rows≈10 cost≈200)
               └─ join inner [d3.d_date_sk = catalog_sales.cs_sold_date_sk] emit-filter 3 from right (rows≈1 cost≈23.2K)
                  ├─ filter (call qdb_in_list |d3.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈400)
                  │  └─ source date_dim AS d3 row-groups (call qdb_in_list |d3.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) use-filter 3 keys=[d3.d_date_sk] (rows≈10 cost≈200)
                  └─ join inner [store_sales.ss_item_sk = catalog_sales.cs_item_sk, store_sales.ss_customer_sk = catalog_sales.cs_bill_customer_sk] emit-filter 4 from left (rows≈1 cost≈18.5K)
                     ├─ join inner [store_sales.ss_sold_date_sk = d1.d_date_sk] emit-filter 5 from left (rows≈1 cost≈14K)
                     │  ├─ join inner [d2.d_date_sk = store_returns.sr_returned_date_sk] emit-filter 6 from right (rows≈1 cost≈9.4K)
                     │  │  ├─ filter (call qdb_in_list |d2.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) (rows≈10 cost≈400)
                     │  │  │  └─ source date_dim AS d2 row-groups (call qdb_in_list |d2.d_quarter_name| (cast "1998Q1" <named StringView>) (cast "1998Q2" <named StringView>) (cast "1998Q3" <named StringView>)) use-filter 6 keys=[d2.d_date_sk] (rows≈10 cost≈200)
                     │  │  └─ join inner [store_returns.sr_item_sk = store_sales.ss_item_sk, store_returns.sr_customer_sk = store_sales.ss_customer_sk, store_returns.sr_ticket_number = store_sales.ss_ticket_number] (rows≈1 cost≈4.8K)
                     │  │     ├─ source store_returns AS store_returns (rows≈10 cost≈200)
                     │  │     └─ source store_sales AS store_sales (rows≈10 cost≈240)
                     │  └─ filter (== |d1.d_quarter_name| (cast "1998Q1" <named StringView>)) (rows≈10 cost≈400)
                     │     └─ source date_dim AS d1 row-groups (== |d1.d_quarter_name| (cast "1998Q1" <named StringView>)) use-filter 5 keys=[d1.d_date_sk] (rows≈10 cost≈200)
                     └─ source catalog_sales AS catalog_sales use-filter 4 keys=[catalog_sales.cs_item_sk, catalog_sales.cs_bill_customer_sk] (rows≈10 cost≈160)
