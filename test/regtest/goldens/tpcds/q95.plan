(query
  (cte 0
    (rel project
      (rel filter
        (rel join (rel source "web_sales" "ws1") (rel source "web_sales" "ws2") () (inner))
        (&& (== |ws1.ws_order_number| |ws2.ws_order_number|) (!= |ws1.ws_warehouse_sk| |ws2.ws_warehouse_sk|)))
      (ws_order_number |ws1.ws_order_number|)
      (wh1 |ws1.ws_warehouse_sk|)
      (wh2 |ws2.ws_warehouse_sk|)))
  (main
    (rel limit
      (rel sort
        (rel project
          (rel aggregate
            (rel project
              (rel aggregate
                (rel filter
                  (rel join
                    (rel join
                      (rel join
                        (rel join
                          (rel join (rel source "web_sales" "ws1") (rel source "date_dim") () (inner))
                          (rel source "customer_address")
                          ()
                          (inner))
                        (rel source "web_site")
                        ()
                        (inner))
                      (rel project
                        (rel project
                          (rel cte-ref 0)
                          (|ws_wh.ws_order_number| ws_order_number)
                          (|ws_wh.wh1| wh1)
                          (|ws_wh.wh2| wh2))
                        (__qdb_in__ws_order_number ws_order_number))
                      ()
                      (left_semi)
                      (residual (== |ws1.ws_order_number| __qdb_in__ws_order_number)))
                    (rel project
                      (rel filter
                        (rel join
                          (rel source "web_returns")
                          (rel project
                            (rel cte-ref 0)
                            (|ws_wh.ws_order_number| ws_order_number)
                            (|ws_wh.wh1| wh1)
                            (|ws_wh.wh2| wh2))
                          ()
                          (inner))
                        (== wr_order_number |ws_wh.ws_order_number|))
                      (__qdb_in__wr_order_number wr_order_number))
                    ()
                    (left_semi)
                    (residual (== |ws1.ws_order_number| __qdb_in__wr_order_number)))
                  (&& (&& (&& (&& (&& (&& (<= (cast "1999-5-01" <named StringView>) d_date)
                              (<= d_date (+ (cast (cast "1999-5-01" <named StringView>) <named DATE>) (: 60 i32))))
                            (== |ws1.ws_ship_date_sk| d_date_sk))
                          (== |ws1.ws_ship_addr_sk| ca_address_sk))
                        (== ca_state (cast "TX" <named StringView>)))
                      (== |ws1.ws_web_site_sk| web_site_sk))
                    (== web_company_name (cast "pri" <named StringView>))))
                (keys ws_order_number)
                (agg partial_sum_1 sum ws_ext_ship_cost)
                (agg partial_sum_2 sum ws_net_profit))
              (ws_order_number ws_order_number)
              (partial_sum_1 partial_sum_1)
              (partial_sum_2 partial_sum_2)
              (__group__ 1))
            (keys __group__)
            (agg count_0 count ws_order_number)
            (agg sum_1 sum partial_sum_1)
            (agg sum_2 sum partial_sum_2))
          (|order count| count_0)
          (|total shipping cost| sum_1)
          (|total net profit| sum_2))
        (|order count| asc nulls-default))
      (limit 100))))
