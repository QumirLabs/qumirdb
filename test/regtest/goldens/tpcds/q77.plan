(query
  (cte 0
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
            (rel source "store")
            ()
            (inner))
          (&& (&& (&& (== ss_sold_date_sk d_date_sk) (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
              (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32))))
            (== ss_store_sk s_store_sk)))
        (keys s_store_sk)
        (agg sum_0 sum ss_ext_sales_price)
        (agg sum_1 sum ss_net_profit))
      (s_store_sk s_store_sk)
      (sales sum_0)
      (profit sum_1)))
  (cte 1
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "store_returns") (rel source "date_dim") () (inner))
            (rel source "store")
            ()
            (inner))
          (&& (&& (&& (== sr_returned_date_sk d_date_sk)
                (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
              (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32))))
            (== sr_store_sk s_store_sk)))
        (keys s_store_sk)
        (agg sum_0 sum sr_return_amt)
        (agg sum_1 sum sr_net_loss))
      (s_store_sk s_store_sk)
      (returns sum_0)
      (profit_loss sum_1)))
  (cte 2
    (rel project
      (rel aggregate
        (rel filter
          (rel join (rel source "catalog_sales") (rel source "date_dim") () (inner))
          (&& (&& (== cs_sold_date_sk d_date_sk) (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
            (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
        (keys cs_call_center_sk)
        (agg sum_0 sum cs_ext_sales_price)
        (agg sum_1 sum cs_net_profit))
      (cs_call_center_sk cs_call_center_sk)
      (sales sum_0)
      (profit sum_1)))
  (cte 3
    (rel project
      (rel aggregate
        (rel filter
          (rel join (rel source "catalog_returns") (rel source "date_dim") () (inner))
          (&& (&& (== cr_returned_date_sk d_date_sk)
              (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
            (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32)))))
        (keys cr_call_center_sk)
        (agg sum_0 sum cr_return_amount)
        (agg sum_1 sum cr_net_loss))
      (cr_call_center_sk cr_call_center_sk)
      (returns sum_0)
      (profit_loss sum_1)))
  (cte 4
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
            (rel source "web_page")
            ()
            (inner))
          (&& (&& (&& (== ws_sold_date_sk d_date_sk) (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
              (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32))))
            (== ws_web_page_sk wp_web_page_sk)))
        (keys wp_web_page_sk)
        (agg sum_0 sum ws_ext_sales_price)
        (agg sum_1 sum ws_net_profit))
      (wp_web_page_sk wp_web_page_sk)
      (sales sum_0)
      (profit sum_1)))
  (cte 5
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join (rel source "web_returns") (rel source "date_dim") () (inner))
            (rel source "web_page")
            ()
            (inner))
          (&& (&& (&& (== wr_returned_date_sk d_date_sk)
                (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
              (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 30 i32))))
            (== wr_web_page_sk wp_web_page_sk)))
        (keys wp_web_page_sk)
        (agg sum_0 sum wr_return_amt)
        (agg sum_1 sum wr_net_loss))
      (wp_web_page_sk wp_web_page_sk)
      (returns sum_0)
      (profit_loss sum_1)))
  (main
    (rel limit
      (rel sort
        (rel project
          (rel aggregate
            (rel project
              (rel project
                (rel union-all
                  (rel project
                    (rel join
                      (rel project (rel cte-ref 0) (|ss.s_store_sk| s_store_sk) (|ss.sales| sales) (|ss.profit| profit))
                      (rel project
                        (rel cte-ref 1)
                        (|sr.s_store_sk| s_store_sk)
                        (|sr.returns| returns)
                        (|sr.profit_loss| profit_loss))
                      ()
                      (left)
                      (residual (== |ss.s_store_sk| |sr.s_store_sk|)))
                    (channel (cast "store channel" <named StringView>))
                    (id |ss.s_store_sk|)
                    (sales sales)
                    (returns (call coalesce returns 0))
                    (profit (- profit (call coalesce profit_loss 0))))
                  (rel project
                    (rel join
                      (rel project
                        (rel cte-ref 2)
                        (|cs.cs_call_center_sk| cs_call_center_sk)
                        (|cs.sales| sales)
                        (|cs.profit| profit))
                      (rel project
                        (rel cte-ref 3)
                        (|cr.cr_call_center_sk| cr_call_center_sk)
                        (|cr.returns| returns)
                        (|cr.profit_loss| profit_loss))
                      ()
                      (inner))
                    (channel (cast "catalog channel" <named StringView>))
                    (id cs_call_center_sk)
                    (sales sales)
                    (returns returns)
                    (profit (- profit profit_loss)))
                  (rel project
                    (rel join
                      (rel project
                        (rel cte-ref 4)
                        (|ws.wp_web_page_sk| wp_web_page_sk)
                        (|ws.sales| sales)
                        (|ws.profit| profit))
                      (rel project
                        (rel cte-ref 5)
                        (|wr.wp_web_page_sk| wp_web_page_sk)
                        (|wr.returns| returns)
                        (|wr.profit_loss| profit_loss))
                      ()
                      (left)
                      (residual (== |ws.wp_web_page_sk| |wr.wp_web_page_sk|)))
                    (channel (cast "web channel" <named StringView>))
                    (id |ws.wp_web_page_sk|)
                    (sales sales)
                    (returns (call coalesce returns 0))
                    (profit (- profit (call coalesce profit_loss 0)))))
                (|x.channel| channel)
                (|x.id| id)
                (|x.sales| sales)
                (|x.returns| returns)
                (|x.profit| profit))
              (channel channel)
              (id id)
              (sales sales)
              (returns returns)
              (profit profit))
            (keys channel id)
            (set channel id)
            (set channel)
            (set)
            (agg sum_0 sum sales)
            (agg sum_1 sum returns)
            (agg sum_2 sum profit))
          (channel channel)
          (id id)
          (sales sum_0)
          (returns sum_1)
          (profit sum_2))
        (channel asc nulls-default)
        (id asc nulls-default))
      (limit 100))))
