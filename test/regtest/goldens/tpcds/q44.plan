top-sort [rnk asc] limit 100
└─ project (rnk, best_performing, worst_performing)
   └─ join inner [descending.item_sk = i2.i_item_sk]
      ├─ join inner [asceding.item_sk = i1.i_item_sk]
      │  ├─ join inner [asceding.rnk = descending.rnk]
      │  │  ├─ project (asceding.item_sk, asceding.rnk)
      │  │  │  └─ project (v11.item_sk, v11.rnk)
      │  │  │     └─ filter (< w_0 11)
      │  │  │        └─ window order=[v1.rank_col asc] fns=[w_0=rank]
      │  │  │           └─ project (v1.item_sk, v1.rank_col) (rows≈10 cost≈5.4K)
      │  │  │              └─ join inner residual (> (/ sum_0 (cast count_1 f64)) (* 0.90000000000000002 __scalar_0__)) (rows≈10 cost≈5.2K)
      │  │  │                 ├─ aggregate keys=[ss1.ss_item_sk] aggs=[sum_0=sum, count_1=count] (rows≈10 cost≈520)
      │  │  │                 │  └─ filter (== |ss1.ss_store_sk| 2) (rows≈10 cost≈320)
      │  │  │                 │     └─ source store_sales AS ss1 row-groups (== |ss1.ss_store_sk| 2) (rows≈10 cost≈160)
      │  │  │                 └─ project (__scalar_0__) (rows≈1 cost≈348)
      │  │  │                    └─ aggregate keys=[store_sales.ss_store_sk] aggs=[sum_0=sum, count_1=count] (rows≈1 cost≈340)
      │  │  │                       └─ filter (&& (== |store_sales.ss_store_sk| 2) (call qdb_is_null |store_sales.ss_hdemo_sk|)) (rows≈1 cost≈320)
      │  │  │                          └─ source store_sales AS store_sales row-groups (&& (call qdb_is_null |store_sales.ss_hdemo_sk|) (== |store_sales.ss_store_sk| 2)) (rows≈10 cost≈160)
      │  │  └─ project (descending.item_sk, descending.rnk)
      │  │     └─ project (v21.item_sk, v21.rnk)
      │  │        └─ filter (< w_0 11)
      │  │           └─ window order=[v2.rank_col desc] fns=[w_0=rank]
      │  │              └─ project (v2.item_sk, v2.rank_col) (rows≈10 cost≈5.4K)
      │  │                 └─ join inner residual (> (/ sum_0 (cast count_1 f64)) (* 0.90000000000000002 __scalar_0__)) (rows≈10 cost≈5.2K)
      │  │                    ├─ aggregate keys=[ss1.ss_item_sk] aggs=[sum_0=sum, count_1=count] (rows≈10 cost≈520)
      │  │                    │  └─ filter (== |ss1.ss_store_sk| 2) (rows≈10 cost≈320)
      │  │                    │     └─ source store_sales AS ss1 row-groups (== |ss1.ss_store_sk| 2) (rows≈10 cost≈160)
      │  │                    └─ project (__scalar_0__) (rows≈1 cost≈348)
      │  │                       └─ aggregate keys=[store_sales_1.ss_store_sk] aggs=[sum_0=sum, count_1=count] (rows≈1 cost≈340)
      │  │                          └─ filter (&& (== |store_sales_1.ss_store_sk| 2) (call qdb_is_null |store_sales_1.ss_hdemo_sk|)) (rows≈1 cost≈320)
      │  │                             └─ source store_sales AS store_sales_1 row-groups (&& (call qdb_is_null |store_sales_1.ss_hdemo_sk|) (== |store_sales_1.ss_store_sk| 2)) (rows≈10 cost≈160)
      │  └─ source item AS i1 (rows≈10 cost≈200)
      └─ source item AS i2 (rows≈10 cost≈200)
