top-sort [channel asc, col_name asc, d_year asc, d_qoy asc, i_category asc] limit 100
└─ project (channel, col_name, d_year, d_qoy, i_category, sales_cnt, sales_amt) (rows≈3 cost≈28.1K)
   └─ aggregate keys=[foo.channel, foo.col_name, foo.d_year, foo.d_qoy, foo.i_category] aggs=[count_0=count, sum_0=sum] (rows≈3 cost≈27.9K)
      └─ project (foo.channel, foo.col_name, foo.d_year, foo.d_qoy, foo.i_category, foo.ext_sales_price) (rows≈3 cost≈27.6K)
         └─ union-all (rows≈3 cost≈27.4K)
            ├─ project (channel, col_name, d_year, d_qoy, i_category, ext_sales_price) (rows≈1 cost≈9.1K)
            │  └─ join inner [store_sales.ss_item_sk = item_0.i_item_sk] emit-filter 1 from left (rows≈1 cost≈9.1K)
            │     ├─ join inner [date_dim_0.d_date_sk = store_sales.ss_sold_date_sk] emit-filter 2 from right (rows≈1 cost≈4.7K)
            │     │  ├─ source date_dim AS date_dim_0 use-filter 2 keys=[date_dim_0.d_date_sk] (rows≈10 cost≈120)
            │     │  └─ filter (call qdb_is_null |store_sales.ss_addr_sk|) (rows≈1 cost≈400)
            │     │     └─ source store_sales AS store_sales row-groups (call qdb_is_null |store_sales.ss_addr_sk|) (rows≈10 cost≈200)
            │     └─ source item AS item_0 use-filter 1 keys=[item_0.i_item_sk] (rows≈10 cost≈200)
            ├─ project (channel, col_name, d_year, d_qoy, i_category, ext_sales_price) (rows≈1 cost≈9.1K)
            │  └─ join inner [web_sales.ws_item_sk = item_1.i_item_sk] emit-filter 3 from left (rows≈1 cost≈9.1K)
            │     ├─ join inner [date_dim_1.d_date_sk = web_sales.ws_sold_date_sk] emit-filter 4 from right (rows≈1 cost≈4.7K)
            │     │  ├─ source date_dim AS date_dim_1 use-filter 4 keys=[date_dim_1.d_date_sk] (rows≈10 cost≈120)
            │     │  └─ filter (call qdb_is_null |web_sales.ws_web_page_sk|) (rows≈1 cost≈400)
            │     │     └─ source web_sales AS web_sales row-groups (call qdb_is_null |web_sales.ws_web_page_sk|) (rows≈10 cost≈200)
            │     └─ source item AS item_1 use-filter 3 keys=[item_1.i_item_sk] (rows≈10 cost≈200)
            └─ project (channel, col_name, d_year, d_qoy, i_category, ext_sales_price) (rows≈1 cost≈9.1K)
