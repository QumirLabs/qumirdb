top-sort [customer_id asc] limit 100
└─ project (customer_id, customername) (rows≈1 cost≈22.4K)
   └─ join inner [customer.c_current_addr_sk = customer_address.ca_address_sk] (rows≈1 cost≈22.4K)
      ├─ join inner [household_demographics.hd_income_band_sk = income_band.ib_income_band_sk] (rows≈1 cost≈17.8K)
      │  ├─ join inner [customer.c_current_hdemo_sk = household_demographics.hd_demo_sk] emit-filter 1 from left (rows≈1 cost≈13.4K)
      │  │  ├─ join inner [customer_demographics.cd_demo_sk = customer.c_current_cdemo_sk] emit-filter 2 from left (rows≈1 cost≈9.1K)
      │  │  │  ├─ join inner [store_returns.sr_cdemo_sk = customer_demographics.cd_demo_sk] (rows≈1 cost≈4.3K)
      │  │  │  │  ├─ source store_returns AS store_returns (rows≈10 cost≈40)
      │  │  │  │  └─ source customer_demographics AS customer_demographics (rows≈10 cost≈40)
      │  │  │  └─ source customer AS customer use-filter 2 keys=[customer.c_current_cdemo_sk] (rows≈10 cost≈600)
      │  │  └─ source household_demographics AS household_demographics use-filter 1 keys=[household_demographics.hd_demo_sk] (rows≈10 cost≈80)
      │  └─ filter (&& (>= |income_band.ib_lower_bound| 32287) (<= |income_band.ib_upper_bound| (+ 32287 50000))) (rows≈2 cost≈240)
      │     └─ source income_band AS income_band row-groups (&& (>= |income_band.ib_lower_bound| 32287) (<= |income_band.ib_upper_bound| (+ 32287 50000))) (rows≈10 cost≈120)
      └─ filter (== |customer_address.ca_city| (cast "Hopewell" <named StringView>)) (rows≈1 cost≈400)
         └─ source customer_address AS customer_address row-groups (== |customer_address.ca_city| (cast "Hopewell" <named StringView>)) (rows≈10 cost≈200)
