top-sort [customer_id asc] limit 100
└─ project (customer_id, customername) (rows≈1 cost≈22.5K)
   └─ join inner [customer.c_current_hdemo_sk = household_demographics.hd_demo_sk] emit-filter 1 from left (rows≈1 cost≈22.5K)
      ├─ join inner [customer_demographics.cd_demo_sk = customer.c_current_cdemo_sk] (rows≈1 cost≈13.7K)
      │  ├─ join inner [store_returns.sr_cdemo_sk = customer_demographics.cd_demo_sk] (rows≈1 cost≈4.3K)
      │  │  ├─ source store_returns AS store_returns (rows≈10 cost≈40)
      │  │  └─ source customer_demographics AS customer_demographics (rows≈10 cost≈40)
      │  └─ join inner [customer_address.ca_address_sk = customer.c_current_addr_sk] emit-filter 2 from left (rows≈1 cost≈5.2K)
      │     ├─ filter (== |customer_address.ca_city| (cast "Hopewell" <named StringView>)) (rows≈1 cost≈400)
      │     │  └─ source customer_address AS customer_address row-groups (== |customer_address.ca_city| (cast "Hopewell" <named StringView>)) (rows≈10 cost≈200)
      │     └─ source customer AS customer use-filter 2 keys=[customer.c_current_addr_sk] (rows≈10 cost≈600)
      └─ join inner [income_band.ib_income_band_sk = household_demographics.hd_income_band_sk] use-filter 1 keys=[household_demographics.hd_demo_sk] (rows≈5 cost≈4.6K)
         ├─ filter (&& (>= |income_band.ib_lower_bound| 32287) (<= |income_band.ib_upper_bound| (+ 32287 50000))) (rows≈5 cost≈240)
         │  └─ source income_band AS income_band row-groups (&& (>= |income_band.ib_lower_bound| 32287) (<= |income_band.ib_upper_bound| (+ 32287 50000))) (rows≈10 cost≈120)
         └─ source household_demographics AS household_demographics (rows≈10 cost≈80)
