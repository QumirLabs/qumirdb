top-sort [i_item_id asc, i_item_desc asc, s_store_id asc, s_store_name asc] limit 100
└─ project (i_item_id, i_item_desc, s_store_id, s_store_name, store_sales_quantity, store_returns_quantity, catalog_sales_quantity) (rows≈1 cost≈32.1K)
   └─ aggregate keys=[item.i_item_id, item.i_item_desc, store.s_store_id, store.s_store_name] aggs=[sum_0=sum, sum_1=sum, sum_2=sum] (rows≈1 cost≈32K)
      └─ join inner [store_sales.ss_store_sk = store.s_store_sk] emit-filter 1 from left (rows≈1 cost≈31.9K)
         ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 2 from right (rows≈1 cost≈27.2K)
         │  ├─ source item AS item use-filter 2 keys=[item.i_item_sk] (rows≈10 cost≈360)
         │  └─ join inner [d3.d_date_sk = catalog_sales.cs_sold_date_sk] emit-filter 3 from right (rows≈1 cost≈22.6K)
         │     ├─ filter (call qdb_in_list |d3.d_year| 1999 (+ 1999 1) (+ 1999 2)) (rows≈10 cost≈160)
         │     │  └─ source date_dim AS d3 row-groups (call qdb_in_list |d3.d_year| 1999 (+ 1999 1) (+ 1999 2)) use-filter 3 keys=[d3.d_date_sk] (rows≈10 cost≈80)
         │     └─ join inner [store_sales.ss_item_sk = catalog_sales.cs_item_sk, store_sales.ss_customer_sk = catalog_sales.cs_bill_customer_sk] (rows≈1 cost≈18.2K)
         │        ├─ join inner [store_sales.ss_sold_date_sk = d1.d_date_sk] emit-filter 4 from left (rows≈2 cost≈13.8K)
         │        │  ├─ join inner [store_returns.sr_item_sk = store_sales.ss_item_sk, store_returns.sr_customer_sk = store_sales.ss_customer_sk, store_returns.sr_ticket_number = store_sales.ss_ticket_number] (rows≈2 cost≈9.2K)
         │        │  │  ├─ join inner [d2.d_date_sk = store_returns.sr_returned_date_sk] (rows≈2 cost≈4.6K)
         │        │  │  │  ├─ filter (&& (&& (<= 4 |d2.d_moy|) (<= |d2.d_moy| (+ 4 3))) (== |d2.d_year| 1999)) (rows≈2 cost≈240)
         │        │  │  │  │  └─ source date_dim AS d2 row-groups (&& (&& (<= 4 |d2.d_moy|) (<= |d2.d_moy| (+ 4 3))) (== |d2.d_year| 1999)) (rows≈10 cost≈120)
         │        │  │  │  └─ source store_returns AS store_returns (rows≈10 cost≈200)
         │        │  │  └─ source store_sales AS store_sales (rows≈10 cost≈240)
         │        │  └─ filter (&& (== |d1.d_moy| 4) (== |d1.d_year| 1999)) (rows≈10 cost≈240)
         │        │     └─ source date_dim AS d1 row-groups (&& (== |d1.d_moy| 4) (== |d1.d_year| 1999)) use-filter 4 keys=[d1.d_date_sk] (rows≈10 cost≈120)
         │        └─ source catalog_sales AS catalog_sales (rows≈10 cost≈160)
         └─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈360)
