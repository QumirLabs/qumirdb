project (i_category, i_class, i_brand, s_store_name, s_company_name, d_moy, sum_sales, avg_monthly_sales)
└─ top-sort [__sort_0 asc, s_store_name asc] limit 100
   └─ project (i_category, i_class, i_brand, s_store_name, s_company_name, d_moy, sum_sales, avg_monthly_sales, __sort_0)
      └─ project (tmp1.i_category, tmp1.i_class, tmp1.i_brand, tmp1.s_store_name, tmp1.s_company_name, tmp1.d_moy, tmp1.sum_sales, tmp1.avg_monthly_sales)
         └─ filter (> (if (call qdb_is_true (!= w_0 0)) (/ (call abs (- sum_0 w_0)) w_0) (call qdb_sql_null)) 0.10000000000000001)
            └─ window partition=[item.i_category, item.i_brand, store.s_store_name, store.s_company_name] fns=[w_0=avg]
               └─ aggregate keys=[item.i_category, item.i_class, item.i_brand, store.s_store_name, store.s_company_name, date_dim.d_moy] aggs=[sum_0=sum] (rows≈1 cost≈14.6K)
                  └─ join inner [store_sales.ss_item_sk = item.i_item_sk] (rows≈1 cost≈14.5K)
                     ├─ join inner [store.s_store_sk = store_sales.ss_store_sk] emit-filter 1 from right (rows≈1 cost≈9.2K)
                     │  ├─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈360)
                     │  └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.6K)
                     │     ├─ filter (call qdb_in_list |date_dim.d_year| 2000) (rows≈10 cost≈240)
                     │     │  └─ source date_dim AS date_dim row-groups (call qdb_in_list |date_dim.d_year| 2000) (rows≈10 cost≈120)
                     │     └─ source store_sales AS store_sales (rows≈10 cost≈200)
                     └─ filter (|| (&& (call qdb_in_list |item.i_category| (cast "Home" <named StringView>) (cast "Books" <named StringView>) (cast "Electronics" <named StringView>)) (call qdb_in_list |item.i_class| (cast "wallpaper" <named StringView>) (cast "parenting" <named StringView>) (cast "musical" <named StringView>))) (&& (call qdb_in_list |item.i_category| (cast "Shoes" <named StringView>) (cast "Jewelry" <named StringView>) (cast "Men" <named StringView>)) (call qdb_in_list |item.i_class| (cast "womens" <named StringView>) (cast "birdal" <named StringView>) (cast "pants" <named StringView>)))) (rows≈5 cost≈1K)
                        └─ source item AS item row-groups (|| (&& (call qdb_in_list |item.i_category| (cast "Home" <named StringView>) (cast "Books" <named StringView>) (cast "Electronics" <named StringView>)) (call qdb_in_list |item.i_class| (cast "wallpaper" <named StringView>) (cast "parenting" <named StringView>) (cast "musical" <named StringView>))) (&& (call qdb_in_list |item.i_category| (cast "Shoes" <named StringView>) (cast "Jewelry" <named StringView>) (cast "Men" <named StringView>)) (call qdb_in_list |item.i_class| (cast "womens" <named StringView>) (cast "birdal" <named StringView>) (cast "pants" <named StringView>)))) (rows≈10 cost≈520)
