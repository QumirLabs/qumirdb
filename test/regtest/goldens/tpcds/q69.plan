top-sort [cd_gender asc, cd_marital_status asc, cd_education_status asc, cd_purchase_estimate asc, cd_credit_rating asc] limit 100
└─ project (cd_gender, cd_marital_status, cd_education_status, cnt1, cd_purchase_estimate, cnt2, cd_credit_rating, cnt3) (rows≈1 cost≈36K)
   └─ aggregate keys=[customer_demographics.cd_gender, customer_demographics.cd_marital_status, customer_demographics.cd_education_status, customer_demographics.cd_purchase_estimate, customer_demographics.cd_credit_rating] aggs=[count_0=count] (rows≈1 cost≈35.9K)
      └─ join left_anti [c.c_customer_sk = catalog_sales.cs_ship_customer_sk] (rows≈1 cost≈35.8K)
         ├─ join left_anti [c.c_customer_sk = web_sales.ws_bill_customer_sk] (rows≈1 cost≈27.1K)
         │  ├─ join left_semi [c.c_customer_sk = store_sales.ss_customer_sk] (rows≈1 cost≈18.4K)
         │  │  ├─ join inner [c.c_current_addr_sk = ca.ca_address_sk] (rows≈1 cost≈9.7K)
         │  │  │  ├─ join inner [customer_demographics.cd_demo_sk = c.c_current_cdemo_sk] (rows≈1 cost≈5.1K)
         │  │  │  │  ├─ source customer_demographics AS customer_demographics (rows≈10 cost≈720)
         │  │  │  │  └─ source customer AS c (rows≈10 cost≈120)
         │  │  │  └─ filter (call qdb_in_list |ca.ca_state| (cast "CO" <named StringView>) (cast "IL" <named StringView>) (cast "MN" <named StringView>)) (rows≈3 cost≈400)
         │  │  │     └─ source customer_address AS ca row-groups (call qdb_in_list |ca.ca_state| (cast "CO" <named StringView>) (cast "IL" <named StringView>) (cast "MN" <named StringView>)) (rows≈10 cost≈200)
         │  │  └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] (rows≈1 cost≈4.5K)
         │  │     ├─ source store_sales AS store_sales (rows≈10 cost≈80)
         │  │     └─ filter (&& (&& (== |date_dim.d_year| 1999) (<= 1 |date_dim.d_moy|)) (<= |date_dim.d_moy| (+ 1 2))) (rows≈2 cost≈240)
         │  │        └─ source date_dim AS date_dim row-groups (&& (&& (<= 1 |date_dim.d_moy|) (<= |date_dim.d_moy| (+ 1 2))) (== |date_dim.d_year| 1999)) (rows≈10 cost≈120)
         │  └─ join inner [web_sales.ws_sold_date_sk = date_dim_1.d_date_sk] (rows≈1 cost≈4.5K)
         │     ├─ source web_sales AS web_sales (rows≈10 cost≈80)
         │     └─ filter (&& (&& (== |date_dim_1.d_year| 1999) (<= 1 |date_dim_1.d_moy|)) (<= |date_dim_1.d_moy| (+ 1 2))) (rows≈2 cost≈240)
         │        └─ source date_dim AS date_dim_1 row-groups (&& (&& (<= 1 |date_dim_1.d_moy|) (<= |date_dim_1.d_moy| (+ 1 2))) (== |date_dim_1.d_year| 1999)) (rows≈10 cost≈120)
         └─ join inner [catalog_sales.cs_sold_date_sk = date_dim_2.d_date_sk] (rows≈1 cost≈4.5K)
            ├─ source catalog_sales AS catalog_sales (rows≈10 cost≈80)
            └─ filter (&& (&& (== |date_dim_2.d_year| 1999) (<= 1 |date_dim_2.d_moy|)) (<= |date_dim_2.d_moy| (+ 1 2))) (rows≈2 cost≈240)
               └─ source date_dim AS date_dim_2 row-groups (&& (&& (<= 1 |date_dim_2.d_moy|) (<= |date_dim_2.d_moy| (+ 1 2))) (== |date_dim_2.d_year| 1999)) (rows≈10 cost≈120)
