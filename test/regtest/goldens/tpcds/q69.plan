(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "customer" "c") (rel source "customer_address" "ca") () (inner))
                  (rel source "customer_demographics")
                  ()
                  (inner))
                (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                ()
                (left_semi)
                (residual (&& (&& (&& (== |c.c_customer_sk| ss_customer_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 1999))
                  (&& (<= 1 d_moy) (<= d_moy (+ 1 2))))))
              (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
              ()
              (left_anti)
              (residual (&& (&& (&& (== |c.c_customer_sk| ws_bill_customer_sk) (== ws_sold_date_sk d_date_sk)) (== d_year 1999))
                (&& (<= 1 d_moy) (<= d_moy (+ 1 2))))))
            (rel join (rel source "catalog_sales") (rel source "date_dim") () (inner))
            ()
            (left_anti)
            (residual (&& (&& (&& (== |c.c_customer_sk| cs_ship_customer_sk) (== cs_sold_date_sk d_date_sk)) (== d_year 1999))
              (&& (<= 1 d_moy) (<= d_moy (+ 1 2))))))
          (&& (&& (== |c.c_current_addr_sk| |ca.ca_address_sk|)
              (call
                qdb_in_list
                ca_state
                (cast "CO" <named StringView>)
                (cast "IL" <named StringView>)
                (cast "MN" <named StringView>)))
            (== cd_demo_sk |c.c_current_cdemo_sk|)))
        (keys cd_gender cd_marital_status cd_education_status cd_purchase_estimate cd_credit_rating)
        (agg count_0 count))
      (cd_gender cd_gender)
      (cd_marital_status cd_marital_status)
      (cd_education_status cd_education_status)
      (cnt1 count_0)
      (cd_purchase_estimate cd_purchase_estimate)
      (cnt2 count_0)
      (cd_credit_rating cd_credit_rating)
      (cnt3 count_0))
    (cd_gender asc nulls-default)
    (cd_marital_status asc nulls-default)
    (cd_education_status asc nulls-default)
    (cd_purchase_estimate asc nulls-default)
    (cd_credit_rating asc nulls-default))
  (limit 100))
