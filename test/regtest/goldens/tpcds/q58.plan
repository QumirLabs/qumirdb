  (main
    (rel limit
      (rel sort
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel project (rel cte-ref 0) (|ss_items.item_id| item_id) (|ss_items.ss_item_rev| ss_item_rev))
                (rel project (rel cte-ref 1) (|cs_items.item_id| item_id) (|cs_items.cs_item_rev| cs_item_rev))
                ()
                (inner))
              (rel project (rel cte-ref 2) (|ws_items.item_id| item_id) (|ws_items.ws_item_rev| ws_item_rev))
              ()
              (inner))
            (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (&& (== |ss_items.item_id| |cs_items.item_id|)
                                      (== |ss_items.item_id| |ws_items.item_id|))
                                    (<= (* 0.90000000000000002 cs_item_rev) ss_item_rev))
