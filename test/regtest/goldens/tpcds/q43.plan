top-sort [s_store_name asc, s_store_id asc, sun_sales asc, mon_sales asc, tue_sales asc, wed_sales asc, thu_sales asc, fri_sales asc, sat_sales asc] limit 100
└─ project (s_store_name, s_store_id, sun_sales, mon_sales, tue_sales, wed_sales, thu_sales, fri_sales, sat_sales) (rows≈1 cost≈10.2K)
   └─ aggregate keys=[store.s_store_name, store.s_store_id] aggs=[sum_0=sum, sum_1=sum, sum_2=sum, sum_3=sum, sum_4=sum, sum_5=sum, sum_6=sum] (rows≈1 cost≈10.1K)
      └─ project (store.s_store_name, store.s_store_id, arg_0, arg_1, arg_2, arg_3, arg_4, arg_5, arg_6) (rows≈1 cost≈10K)
         └─ join inner [store.s_store_sk = store_sales.ss_store_sk] (rows≈1 cost≈9.9K)
            ├─ filter (== |store.s_gmt_offset| (- 5)) (rows≈5 cost≈880)
            │  └─ source store AS store row-groups (== |store.s_gmt_offset| (- 5)) (rows≈10 cost≈440)
            └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] (rows≈1 cost≈4.8K)
               ├─ source store_sales AS store_sales (rows≈10 cost≈160)
               └─ filter (== |date_dim.d_year| 1998) (rows≈1 cost≈480)
                  └─ source date_dim AS date_dim row-groups (== |date_dim.d_year| 1998) (rows≈10 cost≈240)
