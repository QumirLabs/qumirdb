sort [ext_price desc, brand_id asc]
└─ project (brand_id, brand, t_hour, t_minute, ext_price) (rows≈1 cost≈25.5K)
   └─ aggregate keys=[item.i_brand, item.i_brand_id, time_dim.t_hour, time_dim.t_minute] aggs=[sum_0=sum] (rows≈1 cost≈25.5K)
      └─ join inner [time_dim.t_time_sk = tmp.time_sk] (rows≈1 cost≈25.5K)
         ├─ filter (|| (== |time_dim.t_meal_time| (cast "breakfast" <named StringView>)) (== |time_dim.t_meal_time| (cast "dinner" <named StringView>))) (rows≈5 cost≈560)
         │  └─ source time_dim AS time_dim row-groups (|| (== |time_dim.t_meal_time| (cast "breakfast" <named StringView>)) (== |time_dim.t_meal_time| (cast "dinner" <named StringView>))) (rows≈10 cost≈280)
         └─ join inner [tmp.sold_item_sk = item.i_item_sk] emit-filter 1 from right (rows≈1 cost≈20.7K)
            ├─ project (tmp.ext_price, tmp.sold_item_sk, tmp.time_sk) (rows≈30 cost≈15.9K)
            │  └─ union-all (rows≈30 cost≈15.4K)
            │     ├─ project (ext_price, sold_date_sk, sold_item_sk, time_sk) (rows≈10 cost≈5.1K)
            │     │  └─ join inner [date_dim_0.d_date_sk = web_sales.ws_sold_date_sk] (rows≈10 cost≈4.9K)
            │     │     ├─ filter (&& (== |date_dim_0.d_moy| 12) (== |date_dim_0.d_year| 2000)) (rows≈10 cost≈240)
            │     │     │  └─ source date_dim AS date_dim_0 row-groups (&& (== |date_dim_0.d_moy| 12) (== |date_dim_0.d_year| 2000)) (rows≈10 cost≈120)
            │     │     └─ source web_sales AS web_sales use-filter 1 keys=[web_sales.ws_item_sk] (rows≈10 cost≈200)
            │     ├─ project (ext_price, sold_date_sk, sold_item_sk, time_sk) (rows≈10 cost≈5.1K)
            │     │  └─ join inner [date_dim_1.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈10 cost≈4.9K)
            │     │     ├─ filter (&& (== |date_dim_1.d_moy| 12) (== |date_dim_1.d_year| 2000)) (rows≈10 cost≈240)
            │     │     │  └─ source date_dim AS date_dim_1 row-groups (&& (== |date_dim_1.d_moy| 12) (== |date_dim_1.d_year| 2000)) (rows≈10 cost≈120)
            │     │     └─ source catalog_sales AS catalog_sales use-filter 1 keys=[catalog_sales.cs_item_sk] (rows≈10 cost≈200)
            │     └─ project (ext_price, sold_date_sk, sold_item_sk, time_sk) (rows≈10 cost≈5.1K)
            │        └─ join inner [date_dim_2.d_date_sk = store_sales.ss_sold_date_sk] (rows≈10 cost≈4.9K)
            │           ├─ filter (&& (== |date_dim_2.d_moy| 12) (== |date_dim_2.d_year| 2000)) (rows≈10 cost≈240)
            │           │  └─ source date_dim AS date_dim_2 row-groups (&& (== |date_dim_2.d_moy| 12) (== |date_dim_2.d_year| 2000)) (rows≈10 cost≈120)
            │           └─ source store_sales AS store_sales use-filter 1 keys=[store_sales.ss_item_sk] (rows≈10 cost≈200)
            └─ filter (== |item.i_manager_id| 1) (rows≈1 cost≈560)
               └─ source item AS item row-groups (== |item.i_manager_id| 1) (rows≈10 cost≈280)
