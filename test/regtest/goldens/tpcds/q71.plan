sort [ext_price desc, brand_id asc]
└─ project (brand_id, brand, t_hour, t_minute, ext_price) (rows≈1 cost≈23.5K)
   └─ aggregate keys=[item.i_brand, item.i_brand_id, time_dim.t_hour, time_dim.t_minute] aggs=[sum_0=sum] (rows≈1 cost≈23.4K)
      └─ join inner [tmp.sold_item_sk = item.i_item_sk] (rows≈1 cost≈23.4K)
         ├─ join inner [time_dim.t_time_sk = tmp.time_sk] (rows≈1 cost≈18.7K)
         │  ├─ filter (|| (== |time_dim.t_meal_time| (cast "breakfast" <named StringView>)) (== |time_dim.t_meal_time| (cast "dinner" <named StringView>))) (rows≈5 cost≈560)
         │  │  └─ source time_dim AS time_dim row-groups (|| (== |time_dim.t_meal_time| (cast "breakfast" <named StringView>)) (== |time_dim.t_meal_time| (cast "dinner" <named StringView>))) (rows≈10 cost≈280)
         │  └─ project (tmp.ext_price, tmp.sold_item_sk, tmp.time_sk) (rows≈3 cost≈13.9K)
         │     └─ union-all (rows≈3 cost≈13.9K)
         │        ├─ project (ext_price, sold_date_sk, sold_item_sk, time_sk) (rows≈1 cost≈4.6K)
         │        │  └─ join inner [date_dim.d_date_sk = web_sales.ws_sold_date_sk] (rows≈1 cost≈4.6K)
         │        │     ├─ filter (&& (== |date_dim.d_moy| 12) (== |date_dim.d_year| 2000)) (rows≈1 cost≈240)
         │        │     │  └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 12) (== |date_dim.d_year| 2000)) (rows≈10 cost≈120)
         │        │     └─ source web_sales AS web_sales (rows≈10 cost≈200)
