top-sort [i_item_id asc, i_item_desc asc, s_store_id asc, s_store_name asc] limit 100
└─ project (i_item_id, i_item_desc, s_store_id, s_store_name, store_sales_profit, store_returns_loss, catalog_sales_profit) (rows≈1 cost≈32.2K)
   └─ aggregate keys=[item.i_item_id, item.i_item_desc, store.s_store_id, store.s_store_name] aggs=[sum_0=sum, sum_1=sum, sum_2=sum] (rows≈1 cost≈32.2K)
      └─ join inner [store_sales.ss_store_sk = store.s_store_sk] emit-filter 1 from left (rows≈1 cost≈32.1K)
         ├─ join inner [store_sales.ss_sold_date_sk = d1.d_date_sk] emit-filter 2 from left (rows≈1 cost≈27.4K)
         │  ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 3 from right (rows≈1 cost≈22.9K)
         │  │  ├─ source item AS item use-filter 3 keys=[item.i_item_sk] (rows≈10 cost≈360)
         │  │  └─ join inner [d3.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈1 cost≈18.2K)
         │  │     ├─ filter (&& (&& (<= 4 |d3.d_moy|) (<= |d3.d_moy| 10)) (== |d3.d_year| 2000)) (rows≈2 cost≈240)
         │  │     │  └─ source date_dim AS d3 row-groups (&& (&& (<= 4 |d3.d_moy|) (<= |d3.d_moy| 10)) (== |d3.d_year| 2000)) (rows≈10 cost≈120)
         │  │     └─ join inner [store_sales.ss_item_sk = catalog_sales.cs_item_sk, store_sales.ss_customer_sk = catalog_sales.cs_bill_customer_sk] emit-filter 4 from left (rows≈1 cost≈13.8K)
         │  │        ├─ join inner [d2.d_date_sk = store_returns.sr_returned_date_sk] (rows≈1 cost≈9.3K)
         │  │        │  ├─ filter (&& (&& (<= 4 |d2.d_moy|) (<= |d2.d_moy| 10)) (== |d2.d_year| 2000)) (rows≈2 cost≈240)
         │  │        │  │  └─ source date_dim AS d2 row-groups (&& (&& (<= 4 |d2.d_moy|) (<= |d2.d_moy| 10)) (== |d2.d_year| 2000)) (rows≈10 cost≈120)
         │  │        │  └─ join inner [store_returns.sr_item_sk = store_sales.ss_item_sk, store_returns.sr_customer_sk = store_sales.ss_customer_sk, store_returns.sr_ticket_number = store_sales.ss_ticket_number] (rows≈1 cost≈4.9K)
         │  │        │     ├─ source store_returns AS store_returns (rows≈10 cost≈240)
         │  │        │     └─ source store_sales AS store_sales (rows≈10 cost≈280)
         │  │        └─ source catalog_sales AS catalog_sales use-filter 4 keys=[catalog_sales.cs_item_sk, catalog_sales.cs_bill_customer_sk] (rows≈10 cost≈200)
         │  └─ filter (&& (== |d1.d_moy| 4) (== |d1.d_year| 2000)) (rows≈10 cost≈240)
         │     └─ source date_dim AS d1 row-groups (&& (== |d1.d_moy| 4) (== |d1.d_year| 2000)) use-filter 2 keys=[d1.d_date_sk] (rows≈10 cost≈120)
         └─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈360)
