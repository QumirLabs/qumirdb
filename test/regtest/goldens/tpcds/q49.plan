project (channel, item, return_ratio, return_rank, currency_rank)
└─ top-sort [__sort_0 asc, __sort_1 asc, __sort_2 asc, __sort_3 asc] limit 100
   └─ project (channel, item, return_ratio, return_rank, currency_rank, __sort_0, __sort_1, __sort_2, __sort_3)
      └─ project (channel, item, return_ratio, return_rank, currency_rank)
         └─ aggregate keys=[channel, item, return_ratio, return_rank, currency_rank]
            └─ union-all
               ├─ project (channel, item, return_ratio, return_rank, currency_rank)
               │  └─ project (web.item, web.return_ratio, web.return_rank, web.currency_rank)
               │     └─ filter (|| (<= w_0 10) (<= w_1 10))
               │        └─ window order=[in_web.currency_ratio asc] fns=[w_1=rank]
               │           └─ window order=[in_web.return_ratio asc] fns=[w_0=rank]
               │              └─ project (in_web.item, in_web.return_ratio, in_web.currency_ratio) (rows≈5 cost≈11.2K)
               │                 └─ aggregate keys=[ws.ws_item_sk] aggs=[sum_0=sum, sum_1=sum, sum_2=sum, sum_3=sum] (rows≈5 cost≈11.1K)
               │                    └─ project (ws.ws_item_sk, arg_0, arg_1, arg_2, arg_3) (rows≈5 cost≈11K)
               │                       └─ join inner [date_dim_0.d_date_sk = ws.ws_sold_date_sk] (rows≈5 cost≈10.8K)
               │                          ├─ filter (&& (== |date_dim_0.d_year| 2000) (== |date_dim_0.d_moy| 12)) (rows≈10 cost≈240)
               │                          │  └─ source date_dim AS date_dim_0 row-groups (&& (== |date_dim_0.d_moy| 12) (== |date_dim_0.d_year| 2000)) (rows≈10 cost≈120)
               │                          └─ filter (> |wr.wr_return_amt| 10000) (rows≈5 cost≈6.1K)
               │                             └─ join left [ws.ws_item_sk = wr.wr_item_sk, ws.ws_order_number = wr.wr_order_number] emit-filter 1 from left (rows≈10 cost≈5.5K)
               │                                ├─ filter (&& (&& (> |ws.ws_net_profit| 1) (> |ws.ws_net_paid| 0)) (> |ws.ws_quantity| 0)) (rows≈1 cost≈640)
               │                                │  └─ source web_sales AS ws row-groups (&& (&& (> |ws.ws_net_paid| 0) (> |ws.ws_net_profit| 1)) (> |ws.ws_quantity| 0)) (rows≈10 cost≈320)
               │                                └─ source web_returns AS wr use-filter 1 keys=[wr.wr_item_sk, wr.wr_order_number] (rows≈10 cost≈200)
               ├─ project (channel, item, return_ratio, return_rank, currency_rank)
               │  └─ project (catalog.item, catalog.return_ratio, catalog.return_rank, catalog.currency_rank)
               │     └─ filter (|| (<= w_0 10) (<= w_1 10))
               │        └─ window order=[in_cat.currency_ratio asc] fns=[w_1=rank]
               │           └─ window order=[in_cat.return_ratio asc] fns=[w_0=rank]
               │              └─ project (in_cat.item, in_cat.return_ratio, in_cat.currency_ratio) (rows≈5 cost≈11.2K)
               │                 └─ aggregate keys=[cs.cs_item_sk] aggs=[sum_0=sum, sum_1=sum, sum_2=sum, sum_3=sum] (rows≈5 cost≈11.1K)
               │                    └─ project (cs.cs_item_sk, arg_0, arg_1, arg_2, arg_3) (rows≈5 cost≈11K)
               │                       └─ join inner [date_dim_1.d_date_sk = cs.cs_sold_date_sk] (rows≈5 cost≈10.8K)
               │                          ├─ filter (&& (== |date_dim_1.d_year| 2000) (== |date_dim_1.d_moy| 12)) (rows≈10 cost≈240)
               │                          │  └─ source date_dim AS date_dim_1 row-groups (&& (== |date_dim_1.d_moy| 12) (== |date_dim_1.d_year| 2000)) (rows≈10 cost≈120)
               │                          └─ filter (> |cr.cr_return_amount| 10000) (rows≈5 cost≈6.1K)
               │                             └─ join left [cs.cs_item_sk = cr.cr_item_sk, cs.cs_order_number = cr.cr_order_number] emit-filter 2 from left (rows≈10 cost≈5.5K)
               │                                ├─ filter (&& (&& (> |cs.cs_net_profit| 1) (> |cs.cs_net_paid| 0)) (> |cs.cs_quantity| 0)) (rows≈1 cost≈640)
               │                                │  └─ source catalog_sales AS cs row-groups (&& (&& (> |cs.cs_net_paid| 0) (> |cs.cs_net_profit| 1)) (> |cs.cs_quantity| 0)) (rows≈10 cost≈320)
               │                                └─ source catalog_returns AS cr use-filter 2 keys=[cr.cr_item_sk, cr.cr_order_number] (rows≈10 cost≈200)
               └─ project (channel, item, return_ratio, return_rank, currency_rank)
                  └─ project (store.item, store.return_ratio, store.return_rank, store.currency_rank)
                     └─ filter (|| (<= w_0 10) (<= w_1 10))
                        └─ window order=[in_store.currency_ratio asc] fns=[w_1=rank]
                           └─ window order=[in_store.return_ratio asc] fns=[w_0=rank]
                              └─ project (in_store.item, in_store.return_ratio, in_store.currency_ratio) (rows≈1 cost≈9.7K)
                                 └─ aggregate keys=[sts.ss_item_sk] aggs=[sum_0=sum, sum_1=sum, sum_2=sum, sum_3=sum] (rows≈1 cost≈9.6K)
                                    └─ project (sts.ss_item_sk, arg_0, arg_1, arg_2, arg_3) (rows≈1 cost≈9.6K)
                                       └─ join inner [date_dim_2.d_date_sk = sts.ss_sold_date_sk] emit-filter 3 from right (rows≈1 cost≈9.6K)
                                          ├─ filter (&& (== |date_dim_2.d_year| 2000) (== |date_dim_2.d_moy| 12)) (rows≈10 cost≈240)
                                          │  └─ source date_dim AS date_dim_2 row-groups (&& (== |date_dim_2.d_moy| 12) (== |date_dim_2.d_year| 2000)) use-filter 3 keys=[date_dim_2.d_date_sk] (rows≈10 cost≈120)
                                          └─ filter (> |sr.sr_return_amt| 10000) (rows≈1 cost≈5.1K)
                                             └─ join left [sts.ss_item_sk = sr.sr_item_sk, sts.ss_ticket_number = sr.sr_ticket_number] emit-filter 4 from left (rows≈1 cost≈5.1K)
                                                ├─ filter (&& (&& (> |sts.ss_net_profit| 1) (> |sts.ss_net_paid| 0)) (> |sts.ss_quantity| 0)) (rows≈1 cost≈640)
                                                │  └─ source store_sales AS sts row-groups (&& (&& (> |sts.ss_net_paid| 0) (> |sts.ss_net_profit| 1)) (> |sts.ss_quantity| 0)) (rows≈10 cost≈320)
                                                └─ source store_returns AS sr use-filter 4 keys=[sr.sr_item_sk, sr.sr_ticket_number] (rows≈10 cost≈200)
