top-sort [ext_price desc, brand_id asc] limit 100
└─ project (brand_id, brand, ext_price) (rows≈1 cost≈9.4K)
   └─ aggregate keys=[item.i_brand, item.i_brand_id] aggs=[sum_0=sum] (rows≈1 cost≈9.4K)
      └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] emit-filter 1 from left (rows≈1 cost≈9.3K)
         ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 2 from left (rows≈1 cost≈4.9K)
         │  ├─ filter (== |item.i_manager_id| 36) (rows≈1 cost≈560)
         │  │  └─ source item AS item row-groups (== |item.i_manager_id| 36) (rows≈10 cost≈280)
         │  └─ source store_sales AS store_sales use-filter 2 keys=[store_sales.ss_item_sk] (rows≈10 cost≈160)
         └─ filter (&& (== |date_dim.d_moy| 12) (== |date_dim.d_year| 2001)) (rows≈10 cost≈240)
            └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 12) (== |date_dim.d_year| 2001)) use-filter 1 keys=[date_dim.d_date_sk] (rows≈10 cost≈120)
