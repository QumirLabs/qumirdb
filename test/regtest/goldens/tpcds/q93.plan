top-sort [sumsales asc, ss_customer_sk asc] limit 100
└─ project (ss_customer_sk, sumsales) (rows≈1 cost≈9.7K)
   └─ aggregate keys=[t.ss_customer_sk] aggs=[sum_0=sum] (rows≈1 cost≈9.7K)
      └─ project (t.ss_customer_sk, t.act_sales) (rows≈1 cost≈9.7K)
         └─ project (ss_customer_sk, act_sales) (rows≈1 cost≈9.7K)
            └─ join inner [store_returns.sr_reason_sk = reason.r_reason_sk] (rows≈1 cost≈9.7K)
               ├─ join left [store_sales.ss_ticket_number = store_returns.sr_ticket_number, store_sales.ss_item_sk = store_returns.sr_item_sk] (rows≈10 cost≈5.1K)
               │  ├─ source store_sales AS store_sales (rows≈10 cost≈240)
               │  └─ source store_returns AS store_returns (rows≈10 cost≈160)
               └─ filter (== |reason.r_reason_desc| (cast "Did not like the warranty" <named StringView>)) (rows≈1 cost≈400)
                  └─ source reason AS reason row-groups (== |reason.r_reason_desc| (cast "Did not like the warranty" <named StringView>)) (rows≈10 cost≈200)
