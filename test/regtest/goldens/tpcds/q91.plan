sort [returns_loss desc]
└─ project (call_center, call_center_name, manager, returns_loss) (rows≈1 cost≈28K)
   └─ aggregate keys=[call_center.cc_call_center_id, call_center.cc_name, call_center.cc_manager, customer_demographics.cd_marital_status, customer_demographics.cd_education_status] aggs=[sum_0=sum] (rows≈1 cost≈27.9K)
      └─ join inner [catalog_returns.cr_call_center_sk = call_center.cc_call_center_sk] emit-filter 1 from left (rows≈1 cost≈27.8K)
         ├─ join inner [catalog_returns.cr_returned_date_sk = date_dim.d_date_sk] emit-filter 2 from left (rows≈1 cost≈23K)
         │  ├─ join inner [customer.c_customer_sk = catalog_returns.cr_returning_customer_sk] emit-filter 3 from left (rows≈1 cost≈18.5K)
         │  │  ├─ join inner [customer.c_current_addr_sk = customer_address.ca_address_sk] (rows≈1 cost≈14.1K)
         │  │  │  ├─ join inner [customer.c_current_cdemo_sk = customer_demographics.cd_demo_sk] (rows≈1 cost≈9.6K)
         │  │  │  │  ├─ join inner [household_demographics.hd_demo_sk = customer.c_current_hdemo_sk] emit-filter 4 from left (rows≈1 cost≈4.7K)
         │  │  │  │  │  ├─ filter (call qdb_string_view_sql_like |household_demographics.hd_buy_potential| (cast "0-500%" <named StringView>)) (rows≈1 cost≈400)
         │  │  │  │  │  │  └─ source household_demographics AS household_demographics row-groups (call qdb_string_view_sql_like |household_demographics.hd_buy_potential| (cast "0-500%" <named StringView>)) (rows≈10 cost≈200)
         │  │  │  │  │  └─ source customer AS customer use-filter 4 keys=[customer.c_current_hdemo_sk] (rows≈10 cost≈160)
         │  │  │  │  └─ filter (|| (&& (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (== |customer_demographics.cd_education_status| (cast "Unknown" <named StringView>))) (&& (== |customer_demographics.cd_marital_status| (cast "W" <named StringView>)) (== |customer_demographics.cd_education_status| (cast "Advanced Degree" <named StringView>)))) (rows≈5 cost≈720)
         │  │  │  │     └─ source customer_demographics AS customer_demographics row-groups (|| (&& (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (== |customer_demographics.cd_education_status| (cast "Unknown" <named StringView>))) (&& (== |customer_demographics.cd_marital_status| (cast "W" <named StringView>)) (== |customer_demographics.cd_education_status| (cast "Advanced Degree" <named StringView>)))) (rows≈10 cost≈360)
         │  │  │  └─ filter (== |customer_address.ca_gmt_offset| (- 7)) (rows≈2 cost≈240)
         │  │  │     └─ source customer_address AS customer_address row-groups (== |customer_address.ca_gmt_offset| (- 7)) (rows≈10 cost≈120)
         │  │  └─ source catalog_returns AS catalog_returns use-filter 3 keys=[catalog_returns.cr_returning_customer_sk] (rows≈10 cost≈200)
         │  └─ filter (&& (== |date_dim.d_year| 1999) (== |date_dim.d_moy| 11)) (rows≈10 cost≈240)
         │     └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 11) (== |date_dim.d_year| 1999)) use-filter 2 keys=[date_dim.d_date_sk] (rows≈10 cost≈120)
         └─ source call_center AS call_center use-filter 1 keys=[call_center.cc_call_center_sk] (rows≈10 cost≈520)
