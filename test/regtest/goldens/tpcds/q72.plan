top-sort [total_cnt desc, i_item_desc asc, w_warehouse_name asc, d_week_seq asc] limit 100
└─ project (i_item_desc, w_warehouse_name, d_week_seq, no_promo, promo, total_cnt) (rows≈1 cost≈44.9K)
   └─ aggregate keys=[item.i_item_desc, warehouse.w_warehouse_name, d1.d_week_seq] aggs=[sum_0=sum, sum_1=sum, count_0=count] (rows≈1 cost≈44.8K)
      └─ project (item.i_item_desc, warehouse.w_warehouse_name, d1.d_week_seq, arg_0, arg_1) (rows≈1 cost≈44.8K)
         └─ join left [catalog_sales.cs_item_sk = catalog_returns.cr_item_sk, catalog_sales.cs_order_number = catalog_returns.cr_order_number] emit-filter 1 from left (rows≈1 cost≈44.7K)
            ├─ join left [catalog_sales.cs_promo_sk = promotion.p_promo_sk] emit-filter 2 from left (rows≈1 cost≈40.3K)
            │  ├─ join inner [d1.d_week_seq = d2.d_week_seq, item.i_item_sk = inventory.inv_item_sk] residual (< |inventory.inv_quantity_on_hand| |catalog_sales.cs_quantity|) (rows≈1 cost≈35.9K)
            │  │  ├─ join inner [catalog_sales.cs_item_sk = item.i_item_sk] emit-filter 3 from left (rows≈1 cost≈22.8K)
            │  │  │  ├─ join inner [catalog_sales.cs_sold_date_sk = d1.d_date_sk] emit-filter 4 from left residual (> |d3.d_date| (+ |d1.d_date| 5)) (rows≈1 cost≈18.4K)
            │  │  │  │  ├─ join inner [d3.d_date_sk = catalog_sales.cs_ship_date_sk] emit-filter 5 from right (rows≈1 cost≈13.8K)
            │  │  │  │  │  ├─ source date_dim AS d3 use-filter 5 keys=[d3.d_date_sk] (rows≈10 cost≈80)
            │  │  │  │  │  └─ join inner [catalog_sales.cs_bill_cdemo_sk = customer_demographics.cd_demo_sk] (rows≈1 cost≈9.5K)
            │  │  │  │  │     ├─ join inner [household_demographics.hd_demo_sk = catalog_sales.cs_bill_hdemo_sk] (rows≈1 cost≈4.9K)
            │  │  │  │  │     │  ├─ filter (== |household_demographics.hd_buy_potential| (cast "1001-5000" <named StringView>)) (rows≈10 cost≈400)
            │  │  │  │  │     │  │  └─ source household_demographics AS household_demographics row-groups (== |household_demographics.hd_buy_potential| (cast "1001-5000" <named StringView>)) (rows≈10 cost≈200)
            │  │  │  │  │     │  └─ source catalog_sales AS catalog_sales (rows≈10 cost≈320)
            │  │  │  │  │     └─ filter (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (rows≈2 cost≈400)
            │  │  │  │  │        └─ source customer_demographics AS customer_demographics row-groups (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (rows≈10 cost≈200)
            │  │  │  │  └─ filter (== |d1.d_year| 2001) (rows≈10 cost≈320)
            │  │  │  │     └─ source date_dim AS d1 row-groups (== |d1.d_year| 2001) use-filter 4 keys=[d1.d_date_sk] (rows≈10 cost≈160)
            │  │  │  └─ source item AS item use-filter 3 keys=[item.i_item_sk] (rows≈10 cost≈200)
            │  │  └─ join inner [inventory.inv_warehouse_sk = warehouse.w_warehouse_sk] emit-filter 6 from left (rows≈1 cost≈8.8K)
            │  │     ├─ join inner [d2.d_date_sk = inventory.inv_date_sk] (rows≈1 cost≈4.4K)
            │  │     │  ├─ source date_dim AS d2 (rows≈10 cost≈80)
            │  │     │  └─ source inventory AS inventory (rows≈10 cost≈160)
            │  │     └─ source warehouse AS warehouse use-filter 6 keys=[warehouse.w_warehouse_sk] (rows≈10 cost≈200)
            │  └─ source promotion AS promotion use-filter 2 keys=[promotion.p_promo_sk] (rows≈10 cost≈40)
            └─ source catalog_returns AS catalog_returns use-filter 1 keys=[catalog_returns.cr_item_sk, catalog_returns.cr_order_number] (rows≈10 cost≈80)
