top-sort [total_cnt desc, i_item_desc asc, w_warehouse_name asc, d_week_seq asc] limit 100
└─ project (i_item_desc, w_warehouse_name, d_week_seq, no_promo, promo, total_cnt) (rows≈1 cost≈45.3K)
   └─ aggregate keys=[i_item_desc, w_warehouse_name, d1.d_week_seq] aggs=[sum_0=sum, sum_1=sum, count_2=count] (rows≈1 cost≈45.3K)
      └─ project (i_item_desc, w_warehouse_name, d1.d_week_seq, arg_0, arg_1) (rows≈1 cost≈45.2K)
         └─ join left [catalog_sales.cs_item_sk = catalog_returns.cr_item_sk, catalog_sales.cs_order_number = catalog_returns.cr_order_number] emit-filter 1 from left (rows≈1 cost≈45.1K)
            ├─ join left [catalog_sales.cs_promo_sk = promotion.p_promo_sk] emit-filter 2 from left (rows≈1 cost≈40.7K)
            │  ├─ join inner [inventory.inv_warehouse_sk = warehouse.w_warehouse_sk] emit-filter 3 from left (rows≈1 cost≈36.4K)
            │  │  ├─ join inner [catalog_sales.cs_item_sk = item.i_item_sk] emit-filter 4 from left (rows≈1 cost≈31.9K)
            │  │  │  ├─ join inner [d3.d_date_sk = catalog_sales.cs_ship_date_sk] emit-filter 5 from right residual (> |d3.d_date| (+ |d1.d_date| 5)) (rows≈1 cost≈27.4K)
            │  │  │  │  ├─ source date_dim AS d3 use-filter 5 keys=[d3.d_date_sk] (rows≈10 cost≈80)
            │  │  │  │  └─ join inner [catalog_sales.cs_bill_hdemo_sk = household_demographics.hd_demo_sk] emit-filter 6 from left (rows≈1 cost≈23K)
            │  │  │  │     ├─ join inner [d2.d_week_seq = d1.d_week_seq, catalog_sales.cs_sold_date_sk = d1.d_date_sk] emit-filter 7 from left (rows≈1 cost≈18.4K)
            │  │  │  │     │  ├─ join inner [d2.d_date_sk = inventory.inv_date_sk] emit-filter 8 from right (rows≈2 cost≈13.8K)
            │  │  │  │     │  │  ├─ source date_dim AS d2 use-filter 8 keys=[d2.d_date_sk] (rows≈10 cost≈80)
            │  │  │  │     │  │  └─ join inner [catalog_sales.cs_item_sk = inventory.inv_item_sk] emit-filter 9 from left residual (< |inventory.inv_quantity_on_hand| |catalog_sales.cs_quantity|) (rows≈2 cost≈9.4K)
            │  │  │  │     │  │     ├─ join inner [customer_demographics.cd_demo_sk = catalog_sales.cs_bill_cdemo_sk] (rows≈2 cost≈5K)
            │  │  │  │     │  │     │  ├─ filter (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (rows≈2 cost≈400)
            │  │  │  │     │  │     │  │  └─ source customer_demographics AS customer_demographics row-groups (== |customer_demographics.cd_marital_status| (cast "M" <named StringView>)) (rows≈10 cost≈200)
            │  │  │  │     │  │     │  └─ source catalog_sales AS catalog_sales (rows≈10 cost≈320)
            │  │  │  │     │  │     └─ source inventory AS inventory use-filter 9 keys=[inventory.inv_item_sk] (rows≈10 cost≈160)
            │  │  │  │     │  └─ filter (== |d1.d_year| 2001) (rows≈10 cost≈320)
            │  │  │  │     │     └─ source date_dim AS d1 row-groups (== |d1.d_year| 2001) use-filter 7 keys=[d1.d_week_seq, d1.d_date_sk] (rows≈10 cost≈160)
            │  │  │  │     └─ filter (== |household_demographics.hd_buy_potential| (cast "1001-5000" <named StringView>)) (rows≈10 cost≈400)
            │  │  │  │        └─ source household_demographics AS household_demographics row-groups (== |household_demographics.hd_buy_potential| (cast "1001-5000" <named StringView>)) use-filter 6 keys=[household_demographics.hd_demo_sk] (rows≈10 cost≈200)
            │  │  │  └─ source item AS item use-filter 4 keys=[item.i_item_sk] (rows≈10 cost≈200)
            │  │  └─ source warehouse AS warehouse use-filter 3 keys=[warehouse.w_warehouse_sk] (rows≈10 cost≈200)
            │  └─ source promotion AS promotion use-filter 2 keys=[promotion.p_promo_sk] (rows≈10 cost≈40)
            └─ source catalog_returns AS catalog_returns use-filter 1 keys=[catalog_returns.cr_item_sk, catalog_returns.cr_order_number] (rows≈10 cost≈80)
