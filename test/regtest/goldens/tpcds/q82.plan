top-sort [i_item_id asc] limit 100
└─ project (i_item_id, i_item_desc, i_current_price) (rows≈1 cost≈14K)
   └─ aggregate keys=[item.i_item_id, item.i_item_desc, item.i_current_price] (rows≈1 cost≈14K)
      └─ join inner [store_sales.ss_item_sk = inventory.inv_item_sk] emit-filter 1 from right (rows≈1 cost≈14K)
         ├─ source store_sales AS store_sales use-filter 1 keys=[store_sales.ss_item_sk] (rows≈10 cost≈40)
         └─ join inner [date_dim.d_date_sk = inventory.inv_date_sk] (rows≈1 cost≈9.7K)
            ├─ filter (&& (<= (cast (cast "2002-05-30" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2002-05-30" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈1 cost≈160)
            │  └─ source date_dim AS date_dim row-groups (&& (<= (cast (cast "2002-05-30" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2002-05-30" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈10 cost≈80)
            └─ join inner [inventory.inv_item_sk = item.i_item_sk] (rows≈1 cost≈5.4K)
               ├─ filter (&& (<= 100 |inventory.inv_quantity_on_hand|) (<= |inventory.inv_quantity_on_hand| 500)) (rows≈2 cost≈240)
               │  └─ source inventory AS inventory row-groups (&& (<= 100 |inventory.inv_quantity_on_hand|) (<= |inventory.inv_quantity_on_hand| 500)) (rows≈10 cost≈120)
               └─ filter (&& (&& (<= 30 |item.i_current_price|) (<= |item.i_current_price| (+ 30 30))) (call qdb_in_list |item.i_manufact_id| 437 129 727 663)) (rows≈1 cost≈960)
                  └─ source item AS item row-groups (&& (&& (<= 30 |item.i_current_price|) (<= |item.i_current_price| (+ 30 30))) (call qdb_in_list |item.i_manufact_id| 437 129 727 663)) (rows≈10 cost≈480)
