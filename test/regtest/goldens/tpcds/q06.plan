top-sort [cnt asc, state asc] limit 100
└─ project (state, cnt) (rows≈1 cost≈27.3K)
   └─ filter (>= count_0 10) (rows≈1 cost≈27.3K)
      └─ aggregate keys=[a.ca_state] aggs=[count_0=count] (rows≈1 cost≈27.3K)
         └─ join inner [__corr_1_0__ = i.i_category] emit-filter 1 from right residual (> |i.i_current_price| (* 1.2 (/ __scalar_1_state_0__ (cast (call coalesce __scalar_1_state_1__ 0) f64)))) (rows≈1 cost≈27.2K)
            ├─ project (__corr_1_0__, __scalar_1_state_0__, __scalar_1_state_1__) (rows≈6 cost≈992)
            │  └─ aggregate keys=[j.i_category] aggs=[sum_0=sum, count_0=count] (rows≈6 cost≈800)
            │     └─ filter (! (call qdb_is_null |j.i_category|)) (rows≈10 cost≈480)
            │        └─ source item AS j row-groups (! (call qdb_is_null |j.i_category|)) use-filter 1 keys=[j.i_category] (rows≈10 cost≈240)
            └─ join inner [s.ss_customer_sk = c.c_customer_sk] (rows≈1 cost≈21.9K)
               ├─ join inner [s.ss_item_sk = i.i_item_sk] emit-filter 2 from left (rows≈1 cost≈13.2K)
               │  ├─ join inner [__scalar_0__ = d.d_month_seq] (rows≈1 cost≈8.8K)
               │  │  ├─ project (__scalar_0__) (rows≈1 cost≈252)
               │  │  │  └─ aggregate keys=[d_month_seq] (rows≈1 cost≈248)
               │  │  │     └─ project (d_month_seq) (rows≈1 cost≈244)
               │  │  │        └─ filter (&& (== |date_dim.d_year| 2000) (== |date_dim.d_moy| 2)) (rows≈1 cost≈240)
               │  │  │           └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 2) (== |date_dim.d_year| 2000)) (rows≈10 cost≈120)
               │  │  └─ join inner [d.d_date_sk = s.ss_sold_date_sk] (rows≈1 cost≈4.4K)
               │  │     ├─ source date_dim AS d (rows≈10 cost≈80)
               │  │     └─ source store_sales AS s (rows≈10 cost≈120)
               │  └─ source item AS i use-filter 2 keys=[i.i_item_sk] (rows≈10 cost≈280)
               └─ join inner [c.c_current_addr_sk = a.ca_address_sk] (rows≈1 cost≈4.5K)
                  ├─ source customer AS c (rows≈10 cost≈80)
                  └─ source customer_address AS a (rows≈10 cost≈200)
