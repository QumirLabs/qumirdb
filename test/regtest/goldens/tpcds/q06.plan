top-sort [cnt asc, state asc] limit 100
└─ project (state, cnt) (rows≈4 cost≈30.5K)
   └─ filter (>= count_0 10) (rows≈4 cost≈30.4K)
      └─ aggregate keys=[a.ca_state] aggs=[count_0=count] (rows≈9 cost≈30.2K)
         └─ join inner [i.i_item_sk = s.ss_item_sk] (rows≈10 cost≈29.9K)
            ├─ join inner [__corr_1_0__ = i.i_category] residual (> |i.i_current_price| (* 1.2 __scalar_1__)) (rows≈10 cost≈6.1K)
            │  ├─ project (__corr_1_0__, __scalar_1__) (rows≈6 cost≈944)
            │  │  └─ aggregate keys=[j.i_category] aggs=[sum_0=sum, count_0=count] (rows≈6 cost≈800)
            │  │     └─ filter (! (call qdb_is_null |j.i_category|)) (rows≈10 cost≈480)
            │  │        └─ source item AS j row-groups (! (call qdb_is_null |j.i_category|)) (rows≈10 cost≈240)
            │  └─ source item AS i (rows≈10 cost≈280)
            └─ join inner [c.c_current_addr_sk = a.ca_address_sk] (rows≈10 cost≈18.6K)
               ├─ join inner [d.d_date_sk = s.ss_sold_date_sk] (rows≈10 cost≈13.7K)
               │  ├─ join inner [__scalar_0__ = d.d_month_seq] (rows≈10 cost≈4.7K)
               │  │  ├─ project (__scalar_0__) (rows≈1 cost≈324)
               │  │  │  └─ aggregate keys=[d_month_seq] (rows≈1 cost≈320)
               │  │  │     └─ project (d_month_seq) (rows≈10 cost≈280)
               │  │  │        └─ filter (&& (== |date_dim.d_year| 2000) (== |date_dim.d_moy| 2)) (rows≈10 cost≈240)
               │  │  │           └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 2) (== |date_dim.d_year| 2000)) (rows≈10 cost≈120)
               │  │  └─ source date_dim AS d (rows≈10 cost≈80)
               │  └─ join inner [s.ss_customer_sk = c.c_customer_sk] (rows≈10 cost≈4.6K)
               │     ├─ source store_sales AS s (rows≈10 cost≈120)
               │     └─ source customer AS c (rows≈10 cost≈80)
               └─ source customer_address AS a (rows≈10 cost≈200)
