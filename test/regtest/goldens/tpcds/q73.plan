sort [cnt desc, c_last_name asc]
└─ project (c_last_name, c_first_name, c_salutation, c_preferred_cust_flag, ss_ticket_number, cnt) (rows≈1 cost≈19K)
   └─ join inner [customer.c_customer_sk = dj.ss_customer_sk] emit-filter 1 from right (rows≈1 cost≈18.9K)
      ├─ source customer AS customer use-filter 1 keys=[customer.c_customer_sk] (rows≈10 cost≈680)
      └─ project (dj.ss_ticket_number, dj.ss_customer_sk, dj.cnt) (rows≈1 cost≈14K)
         └─ project (ss_ticket_number, ss_customer_sk, cnt) (rows≈1 cost≈14K)
            └─ filter (&& (<= 1 count_0) (<= count_0 5)) (rows≈1 cost≈14K)
               └─ aggregate keys=[store_sales.ss_ticket_number, store_sales.ss_customer_sk] aggs=[count_0=count] (rows≈1 cost≈14K)
                  └─ join inner [store_sales.ss_store_sk = store.s_store_sk] emit-filter 2 from left (rows≈1 cost≈14K)
                     ├─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] (rows≈1 cost≈9.4K)
                     │  ├─ join inner [household_demographics.hd_demo_sk = store_sales.ss_hdemo_sk] (rows≈1 cost≈4.9K)
                     │  │  ├─ filter (&& (&& (|| (== |household_demographics.hd_buy_potential| (cast ">10000" <named StringView>)) (== |household_demographics.hd_buy_potential| (cast "Unknown" <named StringView>))) (> |household_demographics.hd_vehicle_count| 0)) (> (if (call qdb_is_true (> |household_demographics.hd_vehicle_count| 0)) (/ |household_demographics.hd_dep_count| |household_demographics.hd_vehicle_count|) (call qdb_sql_null)) 1)) (rows≈1 cost≈560)
                     │  │  │  └─ source household_demographics AS household_demographics row-groups (&& (&& (|| (== |household_demographics.hd_buy_potential| (cast ">10000" <named StringView>)) (== |household_demographics.hd_buy_potential| (cast "Unknown" <named StringView>))) (> (if (call qdb_is_true (> |household_demographics.hd_vehicle_count| 0)) (/ |household_demographics.hd_dep_count| |household_demographics.hd_vehicle_count|) (call qdb_sql_null)) 1)) (> |household_demographics.hd_vehicle_count| 0)) (rows≈10 cost≈280)
                     │  │  └─ source store_sales AS store_sales (rows≈10 cost≈200)
                     │  └─ filter (&& (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 2)) (call qdb_in_list |date_dim.d_year| 1998 (+ 1998 1) (+ 1998 2))) (rows≈2 cost≈240)
                     │     └─ source date_dim AS date_dim row-groups (&& (&& (<= 1 |date_dim.d_dom|) (<= |date_dim.d_dom| 2)) (call qdb_in_list |date_dim.d_year| 1998 (+ 1998 1) (+ 1998 2))) (rows≈10 cost≈120)
                     └─ filter (call qdb_in_list |store.s_county| (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>)) (rows≈10 cost≈400)
                        └─ source store AS store row-groups (call qdb_in_list |store.s_county| (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>) (cast "Williamson County" <named StringView>)) use-filter 2 keys=[store.s_store_sk] (rows≈10 cost≈200)
