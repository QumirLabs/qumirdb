(query
  (cte 0
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel project
                (rel union-all
                  (rel project
                    (rel source "store_sales")
                    (store_sk ss_store_sk)
                    (date_sk ss_sold_date_sk)
                    (sales_price ss_ext_sales_price)
                    (profit ss_net_profit)
                    (return_amt (cast 0 <named DECIMAL [7 2]>))
