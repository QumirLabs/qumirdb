                  (rel project
                    (rel source "store_returns")
                    (store_sk sr_store_sk)
                    (date_sk sr_returned_date_sk)
                    (sales_price (cast 0 <named DECIMAL [7 2]>))
                    (profit (cast 0 <named DECIMAL [7 2]>))
                    (return_amt sr_return_amt)
                    (net_loss sr_net_loss)))
                (|salesreturns.store_sk| store_sk)
                (|salesreturns.date_sk| date_sk)
                (|salesreturns.sales_price| sales_price)
                (|salesreturns.profit| profit)
                (|salesreturns.return_amt| return_amt)
                (|salesreturns.net_loss| net_loss))
              (rel source "date_dim")
              ()
              (inner))
            (rel source "store")
            ()
            (inner))
          (&& (&& (&& (== date_sk d_date_sk) (<= (cast (cast "1998-08-04" <named StringView>) <named DATE>) d_date))
              (<= d_date (+ (cast (cast "1998-08-04" <named StringView>) <named DATE>) (: 14 i32))))
            (== store_sk s_store_sk)))
        (keys s_store_id)
        (agg sum_0 sum sales_price)
        (agg sum_1 sum profit)
        (agg sum_2 sum return_amt)
        (agg sum_3 sum net_loss))
      (s_store_id s_store_id)
      (sales sum_0)
      (profit sum_1)
      (returns sum_2)
      (profit_loss sum_3)))
