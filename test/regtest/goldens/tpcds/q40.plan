(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel join
                  (rel join
                    (rel source "catalog_sales")
                    (rel source "catalog_returns")
                    ()
                    (left)
                    (residual (&& (== cs_order_number cr_order_number) (== cs_item_sk cr_item_sk))))
                  (rel source "warehouse")
                  ()
                  (inner))
                (rel source "item")
                ()
                (inner))
              (rel source "date_dim")
              ()
              (inner))
            (&& (&& (&& (&& (&& (&& (<= 0.98999999999999999 i_current_price) (<= i_current_price 1.49))
                      (== i_item_sk cs_item_sk))
                    (== cs_warehouse_sk w_warehouse_sk))
                  (== cs_sold_date_sk d_date_sk))
                (<= (- (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)) d_date))
              (<= d_date (+ (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)))))
          (w_state w_state)
          (i_item_id i_item_id)
          (arg_0 (if
              (call
                qdb_is_true
                (< (cast d_date <named DATE>) (cast (cast "1998-04-08" <named StringView>) <named DATE>)))
              (- cs_sales_price (call coalesce cr_refunded_cash 0))
              0))
          (arg_1 (if
              (call
                qdb_is_true
                (>= (cast d_date <named DATE>) (cast (cast "1998-04-08" <named StringView>) <named DATE>)))
              (- cs_sales_price (call coalesce cr_refunded_cash 0))
              0)))
        (keys w_state i_item_id)
        (agg sum_0 sum arg_0)
        (agg sum_1 sum arg_1))
      (w_state w_state)
      (i_item_id i_item_id)
      (sales_before sum_0)
      (sales_after sum_1))
    (w_state asc nulls-default)
    (i_item_id asc nulls-default))
  (limit 100))
