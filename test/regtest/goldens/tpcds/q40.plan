top-sort [w_state asc, i_item_id asc] limit 100
└─ project (w_state, i_item_id, sales_before, sales_after) (rows≈1 cost≈18.7K)
   └─ aggregate keys=[warehouse.w_state, item.i_item_id] aggs=[sum_0=sum, sum_1=sum] (rows≈1 cost≈18.7K)
      └─ project (warehouse.w_state, item.i_item_id, arg_0, arg_1) (rows≈1 cost≈18.6K)
         └─ join inner [catalog_sales.cs_warehouse_sk = warehouse.w_warehouse_sk] emit-filter 1 from left (rows≈1 cost≈18.6K)
            ├─ join inner [catalog_sales.cs_item_sk = item.i_item_sk] (rows≈1 cost≈14.1K)
            │  ├─ join inner [date_dim.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈1 cost≈9.4K)
            │  │  ├─ filter (&& (<= (- (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈1 cost≈160)
            │  │  │  └─ source date_dim AS date_dim row-groups (&& (<= (- (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1998-04-08" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈10 cost≈80)
            │  │  └─ join left [catalog_sales.cs_item_sk = catalog_returns.cr_item_sk, catalog_sales.cs_order_number = catalog_returns.cr_order_number] (rows≈10 cost≈5.1K)
            │  │     ├─ source catalog_sales AS catalog_sales (rows≈10 cost≈240)
            │  │     └─ source catalog_returns AS catalog_returns (rows≈10 cost≈160)
            │  └─ filter (&& (<= 0.98999999999999999 |item.i_current_price|) (<= |item.i_current_price| 1.49)) (rows≈1 cost≈560)
            │     └─ source item AS item row-groups (&& (<= 0.98999999999999999 |item.i_current_price|) (<= |item.i_current_price| 1.49)) (rows≈10 cost≈280)
            └─ source warehouse AS warehouse use-filter 1 keys=[warehouse.w_warehouse_sk] (rows≈10 cost≈200)
