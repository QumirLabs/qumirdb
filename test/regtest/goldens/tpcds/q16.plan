(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel project
          (rel aggregate
            (rel filter
              (rel join
                (rel join
                  (rel join
                    (rel join
                      (rel join (rel source "catalog_sales" "cs1") (rel source "date_dim") () (inner))
                      (rel source "customer_address")
                      ()
                      (inner))
                    (rel source "call_center")
                    ()
                    (inner))
                  (rel source "catalog_sales" "cs2")
                  ()
                  (left_semi)
                  (residual (&& (== |cs1.cs_order_number| |cs2.cs_order_number|) (!= |cs1.cs_warehouse_sk| |cs2.cs_warehouse_sk|))))
                (rel source "catalog_returns" "cr1")
                ()
                (left_anti)
                (residual (== |cs1.cs_order_number| |cr1.cr_order_number|)))
              (&& (&& (&& (&& (&& (&& (<= (cast "1999-2-01" <named StringView>) d_date)
                          (<= d_date (+ (cast (cast "1999-2-01" <named StringView>) <named DATE>) (: 60 i32))))
                        (== |cs1.cs_ship_date_sk| d_date_sk))
                      (== |cs1.cs_ship_addr_sk| ca_address_sk))
                    (== ca_state (cast "IL" <named StringView>)))
                  (== |cs1.cs_call_center_sk| cc_call_center_sk))
                (call
                  qdb_in_list
                  cc_county
                  (cast "Williamson County" <named StringView>)
                  (cast "Williamson County" <named StringView>)
                  (cast "Williamson County" <named StringView>)
                  (cast "Williamson County" <named StringView>)
                  (cast "Williamson County" <named StringView>))))
            (keys cs_order_number)
            (agg partial_sum_1 sum cs_ext_ship_cost)
            (agg partial_sum_2 sum cs_net_profit))
          (cs_order_number cs_order_number)
          (partial_sum_1 partial_sum_1)
          (partial_sum_2 partial_sum_2)
          (__group__ 1))
        (keys __group__)
        (agg count_0 count cs_order_number)
        (agg sum_1 sum partial_sum_1)
        (agg sum_2 sum partial_sum_2))
      (|order count| count_0)
      (|total shipping cost| sum_1)
      (|total net profit| sum_2))
    (|order count| asc nulls-default))
  (limit 100))
