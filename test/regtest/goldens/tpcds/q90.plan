top-sort [am_pm_ratio asc] limit 100
└─ project (am_pm_ratio) (rows≈1 cost≈30.3K)
   └─ join inner (rows≈1 cost≈30.3K)
      ├─ project (at.amc) (rows≈1 cost≈13.1K)
      │  └─ aggregate keys=[__group__] aggs=[count_0=count] (rows≈1 cost≈13.1K)
      │     └─ project (__group__) (rows≈1 cost≈13.1K)
      │        └─ join inner [web_sales.ws_ship_hdemo_sk = household_demographics.hd_demo_sk] emit-filter 1 from left (rows≈1 cost≈13.1K)
      │           ├─ join inner [web_page.wp_web_page_sk = web_sales.ws_web_page_sk] (rows≈1 cost≈8.7K)
      │           │  ├─ filter (&& (<= 5000 |web_page.wp_char_count|) (<= |web_page.wp_char_count| 5200)) (rows≈2 cost≈160)
      │           │  │  └─ source web_page AS web_page row-groups (&& (<= 5000 |web_page.wp_char_count|) (<= |web_page.wp_char_count| 5200)) (rows≈10 cost≈80)
      │           │  └─ join inner [time_dim.t_time_sk = web_sales.ws_sold_time_sk] (rows≈1 cost≈4.4K)
      │           │     ├─ filter (&& (<= 6 |time_dim.t_hour|) (<= |time_dim.t_hour| (+ 6 1))) (rows≈2 cost≈160)
      │           │     │  └─ source time_dim AS time_dim row-groups (&& (<= 6 |time_dim.t_hour|) (<= |time_dim.t_hour| (+ 6 1))) (rows≈10 cost≈80)
      │           │     └─ source web_sales AS web_sales (rows≈10 cost≈120)
      │           └─ filter (== |household_demographics.hd_dep_count| 8) (rows≈10 cost≈160)
      │              └─ source household_demographics AS household_demographics row-groups (== |household_demographics.hd_dep_count| 8) use-filter 1 keys=[household_demographics.hd_demo_sk] (rows≈10 cost≈80)
      └─ project (pt.pmc) (rows≈1 cost≈13.1K)
         └─ aggregate keys=[__group__] aggs=[count_0=count] (rows≈1 cost≈13.1K)
            └─ project (__group__) (rows≈1 cost≈13.1K)
               └─ join inner [web_sales_1.ws_ship_hdemo_sk = household_demographics_1.hd_demo_sk] emit-filter 2 from left (rows≈1 cost≈13.1K)
                  ├─ join inner [web_page_1.wp_web_page_sk = web_sales_1.ws_web_page_sk] (rows≈1 cost≈8.7K)
                  │  ├─ filter (&& (<= 5000 |web_page_1.wp_char_count|) (<= |web_page_1.wp_char_count| 5200)) (rows≈2 cost≈160)
                  │  │  └─ source web_page AS web_page_1 row-groups (&& (<= 5000 |web_page_1.wp_char_count|) (<= |web_page_1.wp_char_count| 5200)) (rows≈10 cost≈80)
                  │  └─ join inner [time_dim_1.t_time_sk = web_sales_1.ws_sold_time_sk] (rows≈1 cost≈4.4K)
                  │     ├─ filter (&& (<= 14 |time_dim_1.t_hour|) (<= |time_dim_1.t_hour| (+ 14 1))) (rows≈2 cost≈160)
                  │     │  └─ source time_dim AS time_dim_1 row-groups (&& (<= 14 |time_dim_1.t_hour|) (<= |time_dim_1.t_hour| (+ 14 1))) (rows≈10 cost≈80)
                  │     └─ source web_sales AS web_sales_1 (rows≈10 cost≈120)
                  └─ filter (== |household_demographics_1.hd_dep_count| 8) (rows≈10 cost≈160)
                     └─ source household_demographics AS household_demographics_1 row-groups (== |household_demographics_1.hd_dep_count| 8) use-filter 2 keys=[household_demographics_1.hd_demo_sk] (rows≈10 cost≈80)
