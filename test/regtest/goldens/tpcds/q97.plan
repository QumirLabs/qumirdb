project (store_only, catalog_only, store_and_catalog)
└─ limit
   └─ aggregate keys=[__group__] aggs=[sum_0=sum, sum_1=sum, sum_2=sum] (rows≈1 cost≈13.2K)
      └─ project (arg_0, arg_1, arg_2, __group__) (rows≈2 cost≈13.1K)
         └─ join full [ssci.customer_sk = csci.customer_sk, ssci.item_sk = csci.item_sk] (rows≈2 cost≈13.1K)
            ├─ project (ssci.customer_sk, ssci.item_sk) (rows≈1 cost≈4.5K)
            │  └─ project (customer_sk, item_sk) (rows≈1 cost≈4.5K)
            │     └─ aggregate keys=[store_sales.ss_customer_sk, store_sales.ss_item_sk] (rows≈1 cost≈4.4K)
            │        └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.4K)
            │           ├─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈1 cost≈160)
            │           │  └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈80)
            │           └─ source store_sales AS store_sales (rows≈10 cost≈120)
            └─ project (csci.customer_sk, csci.item_sk) (rows≈1 cost≈4.5K)
               └─ project (customer_sk, item_sk) (rows≈1 cost≈4.5K)
                  └─ aggregate keys=[catalog_sales.cs_bill_customer_sk, catalog_sales.cs_item_sk] (rows≈1 cost≈4.4K)
                     └─ join inner [date_dim.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈1 cost≈4.4K)
                        ├─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈1 cost≈160)
                        │  └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈80)
                        └─ source catalog_sales AS catalog_sales (rows≈10 cost≈120)
