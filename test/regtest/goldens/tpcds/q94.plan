top-sort [order count asc] limit 100
└─ project (order count, total shipping cost, total net profit) (rows≈1 cost≈22.6K)
   └─ aggregate keys=[__group__] aggs=[count_0=count, sum_0=sum, sum_1=sum] (rows≈1 cost≈22.6K)
      └─ project (ws_order_number, partial_0, partial_1, __group__) (rows≈1 cost≈22.5K)
         └─ aggregate keys=[ws1.ws_order_number] aggs=[partial_0=sum, partial_1=sum] (rows≈1 cost≈22.5K)
            └─ join left_anti [ws1.ws_order_number = wr1.wr_order_number] (rows≈1 cost≈22.5K)
               ├─ join left_semi [ws1.ws_order_number = ws2.ws_order_number] residual (!= |ws1.ws_warehouse_sk| |ws2.ws_warehouse_sk|) (rows≈1 cost≈18.2K)
               │  ├─ join inner [ws1.ws_ship_date_sk = date_dim.d_date_sk] (rows≈1 cost≈13.9K)
               │  │  ├─ join inner [web_site.web_site_sk = ws1.ws_web_site_sk] (rows≈1 cost≈9.5K)
               │  │  │  ├─ filter (== |web_site.web_company_name| (cast "pri" <named StringView>)) (rows≈2 cost≈400)
               │  │  │  │  └─ source web_site AS web_site row-groups (== |web_site.web_company_name| (cast "pri" <named StringView>)) (rows≈10 cost≈200)
               │  │  │  └─ join inner [customer_address.ca_address_sk = ws1.ws_ship_addr_sk] (rows≈1 cost≈5K)
               │  │  │     ├─ filter (== |customer_address.ca_state| (cast "TX" <named StringView>)) (rows≈1 cost≈400)
               │  │  │     │  └─ source customer_address AS customer_address row-groups (== |customer_address.ca_state| (cast "TX" <named StringView>)) (rows≈10 cost≈200)
               │  │  │     └─ source web_sales AS ws1 (rows≈10 cost≈360)
               │  │  └─ filter (&& (<= (cast "1999-5-01" <named StringView>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1999-5-01" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈5 cost≈160)
               │  │     └─ source date_dim AS date_dim row-groups (&& (<= (cast "1999-5-01" <named StringView>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "1999-5-01" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈10 cost≈80)
               │  └─ source web_sales AS ws2 (rows≈10 cost≈80)
               └─ source web_returns AS wr1 (rows≈10 cost≈40)
