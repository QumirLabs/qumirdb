top-sort [s_store_name asc, s_company_id asc, s_street_number asc, s_street_name asc, s_street_type asc, s_suite_number asc, s_city asc, s_county asc, s_state asc, s_zip asc] limit 100
└─ project (s_store_name, s_company_id, s_street_number, s_street_name, s_street_type, s_suite_number, s_city, s_county, s_state, s_zip, 30 days, 31-60 days, 61-90 days, 91-120 days, >120 days) (rows≈1 cost≈19.6K)
   └─ aggregate keys=[store.s_store_name, store.s_company_id, store.s_street_number, store.s_street_name, store.s_street_type, store.s_suite_number, store.s_city, store.s_county, store.s_state, store.s_zip] aggs=[sum_0=sum, sum_1=sum, sum_2=sum, sum_3=sum, sum_4=sum] (rows≈1 cost≈19.4K)
      └─ project (store.s_store_name, store.s_company_id, store.s_street_number, store.s_street_name, store.s_street_type, store.s_suite_number, store.s_city, store.s_county, store.s_state, store.s_zip, arg_0, arg_1, arg_2, arg_3, arg_4) (rows≈1 cost≈19.2K)
         └─ join inner [store_sales.ss_store_sk = store.s_store_sk] emit-filter 1 from left (rows≈1 cost≈19K)
            ├─ join inner [store_returns.sr_ticket_number = store_sales.ss_ticket_number, store_returns.sr_item_sk = store_sales.ss_item_sk, store_returns.sr_customer_sk = store_sales.ss_customer_sk] (rows≈1 cost≈13.2K)
            │  ├─ join inner [d2.d_date_sk = store_returns.sr_returned_date_sk] emit-filter 2 from left (rows≈1 cost≈4.6K)
            │  │  ├─ filter (&& (== |d2.d_year| 2000) (== |d2.d_moy| 9)) (rows≈1 cost≈240)
            │  │  │  └─ source date_dim AS d2 row-groups (&& (== |d2.d_moy| 9) (== |d2.d_year| 2000)) (rows≈10 cost≈120)
            │  │  └─ source store_returns AS store_returns use-filter 2 keys=[store_returns.sr_returned_date_sk] (rows≈10 cost≈160)
            │  └─ join inner [d1.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.4K)
            │     ├─ source date_dim AS d1 (rows≈10 cost≈40)
            │     └─ source store_sales AS store_sales (rows≈10 cost≈200)
            └─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈1.5K)
