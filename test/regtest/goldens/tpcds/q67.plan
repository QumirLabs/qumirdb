top-sort [i_category asc, i_class asc, i_brand asc, i_product_name asc, d_year asc, d_qoy asc, d_moy asc, s_store_id asc, sumsales asc, rk asc] limit 100
└─ project (i_category, i_class, i_brand, i_product_name, d_year, d_qoy, d_moy, s_store_id, sumsales, rk)
   └─ project (dw2.i_category, dw2.i_class, dw2.i_brand, dw2.i_product_name, dw2.d_year, dw2.d_qoy, dw2.d_moy, dw2.s_store_id, dw2.sumsales, dw2.rk)
      └─ filter (<= w_0 100)
         └─ window partition=[dw1.i_category] order=[dw1.sumsales desc] fns=[w_0=rank]
            └─ project (dw1.i_category, dw1.i_class, dw1.i_brand, dw1.i_product_name, dw1.d_year, dw1.d_qoy, dw1.d_moy, dw1.s_store_id, dw1.sumsales) (rows≈9 cost≈16.2K)
               └─ aggregate keys=[item.i_category, item.i_class, item.i_brand, item.i_product_name, date_dim.d_year, date_dim.d_qoy, date_dim.d_moy, store.s_store_id] aggs=[sum_0=sum] (rows≈9 cost≈15.3K)
                  └─ project (item.i_category, item.i_class, item.i_brand, item.i_product_name, date_dim.d_year, date_dim.d_qoy, date_dim.d_moy, store.s_store_id, arg_0) (rows≈1 cost≈14.4K)
                     └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] (rows≈1 cost≈14.3K)
                        ├─ join inner [store_sales.ss_store_sk = store.s_store_sk] emit-filter 1 from left (rows≈1 cost≈9.6K)
                        │  ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] (rows≈1 cost≈5.2K)
                        │  │  ├─ source item AS item (rows≈10 cost≈680)
                        │  │  └─ source store_sales AS store_sales (rows≈10 cost≈240)
                        │  └─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈200)
                        └─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈2 cost≈400)
                           └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈200)
