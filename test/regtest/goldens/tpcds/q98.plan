sort [i_category asc, i_class asc, i_item_id asc, i_item_desc asc, revenueratio asc]
└─ project (i_item_id, i_item_desc, i_category, i_class, i_current_price, itemrevenue, revenueratio)
   └─ window partition=[item.i_class] fns=[w_0=sum]
      └─ aggregate keys=[item.i_item_id, item.i_item_desc, item.i_category, item.i_class, item.i_current_price] aggs=[sum_0=sum] (rows≈1 cost≈10.3K)
         └─ join inner [store_sales.ss_item_sk = item.i_item_sk] (rows≈1 cost≈10.3K)
            ├─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈2 cost≈4.5K)
            │  ├─ filter (&& (<= (cast (cast "2001-01-12" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2001-01-12" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈2 cost≈160)
            │  │  └─ source date_dim AS date_dim row-groups (&& (<= (cast (cast "2001-01-12" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2001-01-12" <named StringView>) <named DATE>) (: 30 i32)))) (rows≈10 cost≈80)
            │  └─ source store_sales AS store_sales (rows≈10 cost≈160)
            └─ filter (call qdb_in_list |item.i_category| (cast "Jewelry" <named StringView>) (cast "Sports" <named StringView>) (cast "Books" <named StringView>)) (rows≈5 cost≈1.5K)
               └─ source item AS item row-groups (call qdb_in_list |item.i_category| (cast "Jewelry" <named StringView>) (cast "Sports" <named StringView>) (cast "Books" <named StringView>)) (rows≈10 cost≈760)
