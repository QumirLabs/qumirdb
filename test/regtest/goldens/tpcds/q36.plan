project (gross_margin, i_category, i_class, lochierarchy, rank_within_parent)
└─ top-sort [lochierarchy desc, __sort_0 asc, rank_within_parent asc] limit 100
   └─ project (gross_margin, i_category, i_class, lochierarchy, rank_within_parent, __sort_0)
      └─ window partition=[wk_0, wk_1] order=[wk_2 asc] fns=[w_0=rank]
         └─ project (__grouping_id__, i_category, i_class, sum_0, sum_1, wk_0, wk_2, wk_1) (rows≈17 cost≈19.5K)
            └─ aggregate keys=[i_category, i_class] aggs=[sum_0=sum, sum_1=sum] (rows≈17 cost≈18K)
               └─ project (i_category, i_class, ss_net_profit, ss_ext_sales_price) (rows≈10 cost≈16.5K)
                  └─ join inner [store.s_store_sk = store_sales.ss_store_sk] (rows≈10 cost≈16K)
                     ├─ filter (call qdb_in_list |store.s_state| (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>)) (rows≈10 cost≈400)
                     │  └─ source store AS store row-groups (call qdb_in_list |store.s_state| (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>) (cast "TN" <named StringView>)) (rows≈10 cost≈200)
                     └─ join inner [store_sales.ss_sold_date_sk = d1.d_date_sk] (rows≈10 cost≈10.5K)
                        ├─ join inner [item.i_item_sk = store_sales.ss_item_sk] (rows≈10 cost≈5.5K)
                        │  ├─ source item AS item (rows≈10 cost≈360)
                        │  └─ source store_sales AS store_sales (rows≈10 cost≈280)
                        └─ filter (== |d1.d_year| 2000) (rows≈10 cost≈160)
                           └─ source date_dim AS d1 row-groups (== |d1.d_year| 2000) (rows≈10 cost≈80)
