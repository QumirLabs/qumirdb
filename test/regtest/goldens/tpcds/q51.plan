top-sort [item_sk asc, d_date asc] limit 100
└─ project (item_sk, d_date, web_sales, store_sales, web_cumulative, store_cumulative)
   └─ project (y.item_sk, y.d_date, y.web_sales, y.store_sales, y.web_cumulative, y.store_cumulative)
      └─ filter (> w_0 w_1)
         └─ window partition=[x.item_sk] order=[x.d_date asc] fns=[w_0=max, w_1=max]
            └─ project (x.item_sk, x.d_date, x.web_sales, x.store_sales)
               └─ join full [web.d_date = store.d_date, web.item_sk = store.item_sk]
                  ├─ project (web.item_sk, web.d_date, web.cume_sales)
                  │  └─ project (item_sk, d_date, cume_sales)
                  │     └─ window partition=[web_sales.ws_item_sk] order=[date_dim.d_date asc] fns=[w_0=sum]
                  │        └─ aggregate keys=[web_sales.ws_item_sk, date_dim.d_date] aggs=[sum_0=sum] (rows≈1 cost≈4.7K)
                  │           └─ join inner [date_dim.d_date_sk = web_sales.ws_sold_date_sk] (rows≈1 cost≈4.7K)
                  │              ├─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈2 cost≈240)
                  │              │  └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈120)
                  │              └─ filter (! (call qdb_is_null |web_sales.ws_item_sk|)) (rows≈10 cost≈320)
                  │                 └─ source web_sales AS web_sales row-groups (! (call qdb_is_null |web_sales.ws_item_sk|)) (rows≈10 cost≈160)
                  └─ project (store.item_sk, store.d_date, store.cume_sales)
                     └─ project (item_sk, d_date, cume_sales)
                        └─ window partition=[store_sales.ss_item_sk] order=[date_dim.d_date asc] fns=[w_0=sum]
                           └─ aggregate keys=[store_sales.ss_item_sk, date_dim.d_date] aggs=[sum_0=sum] (rows≈1 cost≈4.7K)
                              └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈1 cost≈4.7K)
                                 ├─ filter (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈2 cost≈240)
                                 │  └─ source date_dim AS date_dim row-groups (&& (<= 1212 |date_dim.d_month_seq|) (<= |date_dim.d_month_seq| (+ 1212 11))) (rows≈10 cost≈120)
                                 └─ filter (! (call qdb_is_null |store_sales.ss_item_sk|)) (rows≈10 cost≈320)
                                    └─ source store_sales AS store_sales row-groups (! (call qdb_is_null |store_sales.ss_item_sk|)) (rows≈10 cost≈160)
