top-sort [avg_quarterly_sales asc, sum_sales asc, i_manufact_id asc] limit 100
└─ project (i_manufact_id, sum_sales, avg_quarterly_sales)
   └─ project (tmp1.i_manufact_id, tmp1.sum_sales, tmp1.avg_quarterly_sales)
      └─ project (i_manufact_id, sum_sales, avg_quarterly_sales)
         └─ filter (> (if (call qdb_is_true (> w_0 0)) (/ (call abs (- sum_0 w_0)) w_0) (call qdb_sql_null)) 0.10000000000000001)
            └─ window partition=[item.i_manufact_id] fns=[w_0=avg]
               └─ aggregate keys=[item.i_manufact_id, date_dim.d_qoy] aggs=[sum_0=sum] (rows≈2 cost≈14.8K)
                  └─ join inner [store.s_store_sk = store_sales.ss_store_sk] emit-filter 1 from right (rows≈2 cost≈14.8K)
                     ├─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈40)
                     └─ join inner [date_dim.d_date_sk = store_sales.ss_sold_date_sk] (rows≈2 cost≈10.4K)
                        ├─ filter (call qdb_in_list |date_dim.d_month_seq| 1212 (+ 1212 1) (+ 1212 2) (+ 1212 3) (+ 1212 4) (+ 1212 5) (+ 1212 6) (+ 1212 7) (+ 1212 8) (+ 1212 9) (+ 1212 10) (+ 1212 11)) (rows≈5 cost≈240)
                        │  └─ source date_dim AS date_dim row-groups (call qdb_in_list |date_dim.d_month_seq| 1212 (+ 1212 1) (+ 1212 2) (+ 1212 3) (+ 1212 4) (+ 1212 5) (+ 1212 6) (+ 1212 7) (+ 1212 8) (+ 1212 9) (+ 1212 10) (+ 1212 11)) (rows≈10 cost≈120)
                        └─ join inner [store_sales.ss_item_sk = item.i_item_sk] (rows≈5 cost≈5.9K)
                           ├─ source store_sales AS store_sales (rows≈10 cost≈200)
                           └─ filter (|| (&& (&& (call qdb_in_list |item.i_category| (cast "Books" <named StringView>) (cast "Children" <named StringView>) (cast "Electronics" <named StringView>)) (call qdb_in_list |item.i_class| (cast "personal" <named StringView>) (cast "portable" <named StringView>) (cast "reference" <named StringView>) (cast "self-help" <named StringView>))) (call qdb_in_list |item.i_brand| (cast "scholaramalgamalg #14" <named StringView>) (cast "scholaramalgamalg #7" <named StringView>) (cast "exportiunivamalg #9" <named StringView>) (cast "scholaramalgamalg #9" <named StringView>))) (&& (&& (call qdb_in_list |item.i_category| (cast "Women" <named StringView>) (cast "Music" <named StringView>) (cast "Men" <named StringView>)) (call qdb_in_list |item.i_class| (cast "accessories" <named StringView>) (cast "classical" <named StringView>) (cast "fragrances" <named StringView>) (cast "pants" <named StringView>))) (call qdb_in_list |item.i_brand| (cast "amalgimporto #1" <named StringView>) (cast "edu packscholar #1" <named StringView>) (cast "exportiimporto #1" <named StringView>) (cast "importoamalg #1" <named StringView>)))) (rows≈5 cost≈1.1K)
                              └─ source item AS item row-groups (|| (&& (&& (call qdb_in_list |item.i_category| (cast "Books" <named StringView>) (cast "Children" <named StringView>) (cast "Electronics" <named StringView>)) (call qdb_in_list |item.i_class| (cast "personal" <named StringView>) (cast "portable" <named StringView>) (cast "reference" <named StringView>) (cast "self-help" <named StringView>))) (call qdb_in_list |item.i_brand| (cast "scholaramalgamalg #14" <named StringView>) (cast "scholaramalgamalg #7" <named StringView>) (cast "exportiunivamalg #9" <named StringView>) (cast "scholaramalgamalg #9" <named StringView>))) (&& (&& (call qdb_in_list |item.i_category| (cast "Women" <named StringView>) (cast "Music" <named StringView>) (cast "Men" <named StringView>)) (call qdb_in_list |item.i_class| (cast "accessories" <named StringView>) (cast "classical" <named StringView>) (cast "fragrances" <named StringView>) (cast "pants" <named StringView>))) (call qdb_in_list |item.i_brand| (cast "amalgimporto #1" <named StringView>) (cast "edu packscholar #1" <named StringView>) (cast "exportiimporto #1" <named StringView>) (cast "importoamalg #1" <named StringView>)))) (rows≈10 cost≈560)
