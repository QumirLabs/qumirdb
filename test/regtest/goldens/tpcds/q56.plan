(query
  (cte 0
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join (rel source "store_sales") (rel source "date_dim") () (inner))
                (rel source "customer_address")
                ()
                (inner))
              (rel source "item")
              ()
              (inner))
            (rel project
              (rel filter
                (rel source "item")
                (call
                  qdb_in_list
                  i_color
                  (cast "orchid" <named StringView>)
                  (cast "chiffon" <named StringView>)
                  (cast "lace" <named StringView>)))
              (__qdb_in__i_item_id i_item_id))
            ()
            (left_semi)
            (residual (== i_item_id __qdb_in__i_item_id)))
          (&& (&& (&& (&& (&& (== ss_item_sk i_item_sk) (== ss_sold_date_sk d_date_sk)) (== d_year 2000)) (== d_moy 1))
              (== ss_addr_sk ca_address_sk))
            (== ca_gmt_offset (- 8))))
        (keys i_item_id)
        (agg sum_0 sum ss_ext_sales_price))
      (i_item_id i_item_id)
      (total_sales sum_0)))
  (cte 1
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join (rel source "catalog_sales") (rel source "date_dim") () (inner))
                (rel source "customer_address")
                ()
                (inner))
              (rel source "item")
              ()
              (inner))
            (rel project
              (rel filter
                (rel source "item")
                (call
                  qdb_in_list
                  i_color
                  (cast "orchid" <named StringView>)
                  (cast "chiffon" <named StringView>)
                  (cast "lace" <named StringView>)))
              (__qdb_in__i_item_id i_item_id))
            ()
            (left_semi)
            (residual (== i_item_id __qdb_in__i_item_id)))
          (&& (&& (&& (&& (&& (== cs_item_sk i_item_sk) (== cs_sold_date_sk d_date_sk)) (== d_year 2000)) (== d_moy 1))
              (== cs_bill_addr_sk ca_address_sk))
            (== ca_gmt_offset (- 8))))
        (keys i_item_id)
        (agg sum_0 sum cs_ext_sales_price))
      (i_item_id i_item_id)
      (total_sales sum_0)))
  (cte 2
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join (rel source "web_sales") (rel source "date_dim") () (inner))
                (rel source "customer_address")
                ()
                (inner))
              (rel source "item")
              ()
              (inner))
            (rel project
              (rel filter
                (rel source "item")
                (call
                  qdb_in_list
                  i_color
                  (cast "orchid" <named StringView>)
                  (cast "chiffon" <named StringView>)
                  (cast "lace" <named StringView>)))
              (__qdb_in__i_item_id i_item_id))
            ()
            (left_semi)
            (residual (== i_item_id __qdb_in__i_item_id)))
          (&& (&& (&& (&& (&& (== ws_item_sk i_item_sk) (== ws_sold_date_sk d_date_sk)) (== d_year 2000)) (== d_moy 1))
              (== ws_bill_addr_sk ca_address_sk))
            (== ca_gmt_offset (- 8))))
        (keys i_item_id)
        (agg sum_0 sum ws_ext_sales_price))
      (i_item_id i_item_id)
      (total_sales sum_0)))
  (main
    (rel limit
      (rel sort
        (rel project
          (rel aggregate
            (rel project
              (rel union-all
                (rel project
                  (rel project (rel cte-ref 0) (|ss.i_item_id| i_item_id) (|ss.total_sales| total_sales))
                  (i_item_id |ss.i_item_id|)
                  (total_sales |ss.total_sales|))
                (rel project
                  (rel project (rel cte-ref 1) (|cs.i_item_id| i_item_id) (|cs.total_sales| total_sales))
                  (i_item_id |cs.i_item_id|)
                  (total_sales |cs.total_sales|))
                (rel project
                  (rel project (rel cte-ref 2) (|ws.i_item_id| i_item_id) (|ws.total_sales| total_sales))
                  (i_item_id |ws.i_item_id|)
                  (total_sales |ws.total_sales|)))
              (|tmp1.i_item_id| i_item_id)
              (|tmp1.total_sales| total_sales))
            (keys i_item_id)
            (agg sum_0 sum total_sales))
          (i_item_id i_item_id)
          (total_sales sum_0))
        (total_sales asc nulls-default)
        (i_item_id asc nulls-default))
      (limit 100))))
