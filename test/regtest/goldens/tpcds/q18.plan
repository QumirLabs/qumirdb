top-sort [ca_country asc, ca_state asc, ca_county asc, i_item_id asc] limit 100
└─ project (i_item_id, ca_country, ca_state, ca_county, agg1, agg2, agg3, agg4, agg5, agg6, agg7) (rows≈13 cost≈35.8K)
   └─ aggregate keys=[i_item_id, ca_country, ca_state, ca_county] aggs=[sum_0=sum, count_1=count, sum_2=sum, count_3=count, sum_4=sum, count_5=count, sum_6=sum, count_7=count, sum_8=sum, count_9=count, sum_10=sum, count_11=count, sum_12=sum, count_13=count] (rows≈13 cost≈34.3K)
      └─ project (i_item_id, ca_country, ca_state, ca_county, arg_0, arg_1, arg_2, arg_3, arg_4, arg_5, arg_6, arg_7, arg_8, arg_9, arg_10, arg_11, arg_12, arg_13) (rows≈3 cost≈31.6K)
         └─ join inner [item.i_item_sk = catalog_sales.cs_item_sk] (rows≈3 cost≈31K)
            ├─ source item AS item (rows≈10 cost≈200)
            └─ join inner [customer.c_current_addr_sk = customer_address.ca_address_sk] (rows≈3 cost≈26.1K)
               ├─ join inner [catalog_sales.cs_bill_customer_sk = customer.c_customer_sk] (rows≈5 cost≈20.4K)
               │  ├─ join inner [date_dim.d_date_sk = catalog_sales.cs_sold_date_sk] (rows≈5 cost≈10.8K)
               │  │  ├─ filter (== |date_dim.d_year| 2001) (rows≈10 cost≈160)
               │  │  │  └─ source date_dim AS date_dim row-groups (== |date_dim.d_year| 2001) (rows≈10 cost≈80)
               │  │  └─ join inner [cd1.cd_demo_sk = catalog_sales.cs_bill_cdemo_sk] (rows≈5 cost≈5.9K)
               │  │     ├─ filter (&& (== |cd1.cd_gender| (cast "M" <named StringView>)) (== |cd1.cd_education_status| (cast "College" <named StringView>))) (rows≈5 cost≈800)
               │  │     │  └─ source customer_demographics AS cd1 row-groups (&& (== |cd1.cd_education_status| (cast "College" <named StringView>)) (== |cd1.cd_gender| (cast "M" <named StringView>))) (rows≈10 cost≈400)
               │  │     └─ source catalog_sales AS catalog_sales (rows≈10 cost≈520)
               │  └─ join inner [customer.c_current_cdemo_sk = cd2.cd_demo_sk] (rows≈10 cost≈4.9K)
               │     ├─ filter (call qdb_in_list |customer.c_birth_month| 9 5 12 4 1 10) (rows≈10 cost≈400)
               │     │  └─ source customer AS customer row-groups (call qdb_in_list |customer.c_birth_month| 9 5 12 4 1 10) (rows≈10 cost≈200)
               │     └─ source customer_demographics AS cd2 (rows≈10 cost≈40)
               └─ filter (call qdb_in_list |customer_address.ca_state| (cast "ND" <named StringView>) (cast "WI" <named StringView>) (cast "AL" <named StringView>) (cast "NC" <named StringView>) (cast "OK" <named StringView>) (cast "MS" <named StringView>) (cast "TN" <named StringView>)) (rows≈7 cost≈1K)
                  └─ source customer_address AS customer_address row-groups (call qdb_in_list |customer_address.ca_state| (cast "ND" <named StringView>) (cast "WI" <named StringView>) (cast "AL" <named StringView>) (cast "NC" <named StringView>) (cast "OK" <named StringView>) (cast "MS" <named StringView>) (cast "TN" <named StringView>)) (rows≈10 cost≈520)
