top-sort [ca_country asc, ca_state asc, ca_county asc, i_item_id asc] limit 100
└─ project (i_item_id, ca_country, ca_state, ca_county, agg1, agg2, agg3, agg4, agg5, agg6, agg7) (rows≈21 cost≈40.9K)
   └─ aggregate keys=[i_item_id, ca_country, ca_state, ca_county] aggs=[sum_0=sum, count_1=count, sum_2=sum, count_3=count, sum_4=sum, count_5=count, sum_6=sum, count_7=count, sum_8=sum, count_9=count, sum_10=sum, count_11=count, sum_12=sum, count_13=count] (rows≈21 cost≈38.4K)
      └─ project (i_item_id, ca_country, ca_state, ca_county, arg_0, arg_1, arg_2, arg_3, arg_4, arg_5, arg_6, arg_7, arg_8, arg_9, arg_10, arg_11, arg_12, arg_13) (rows≈5 cost≈33.9K)
         └─ join inner [catalog_sales.cs_sold_date_sk = date_dim.d_date_sk] (rows≈5 cost≈33K)
            ├─ join inner [item.i_item_sk = catalog_sales.cs_item_sk] (rows≈5 cost≈27.7K)
            │  ├─ source item AS item (rows≈10 cost≈200)
            │  └─ join inner [customer.c_current_cdemo_sk = cd2.cd_demo_sk] (rows≈5 cost≈22.4K)
            │     ├─ join inner [catalog_sales.cs_bill_cdemo_sk = cd1.cd_demo_sk] (rows≈5 cost≈17.4K)
            │     │  ├─ join inner [customer.c_customer_sk = catalog_sales.cs_bill_customer_sk] (rows≈10 cost≈11.6K)
            │     │  │  ├─ join inner [customer_address.ca_address_sk = customer.c_current_addr_sk] (rows≈2 cost≈5.7K)
            │     │  │  │  ├─ filter (call qdb_in_list |customer_address.ca_state| (cast "ND" <named StringView>) (cast "WI" <named StringView>) (cast "AL" <named StringView>) (cast "NC" <named StringView>) (cast "OK" <named StringView>) (cast "MS" <named StringView>) (cast "TN" <named StringView>)) (rows≈5 cost≈1K)
            │     │  │  │  │  └─ source customer_address AS customer_address row-groups (call qdb_in_list |customer_address.ca_state| (cast "ND" <named StringView>) (cast "WI" <named StringView>) (cast "AL" <named StringView>) (cast "NC" <named StringView>) (cast "OK" <named StringView>) (cast "MS" <named StringView>) (cast "TN" <named StringView>)) (rows≈10 cost≈520)
            │     │  │  │  └─ filter (call qdb_in_list |customer.c_birth_month| 9 5 12 4 1 10) (rows≈5 cost≈400)
            │     │  │  │     └─ source customer AS customer row-groups (call qdb_in_list |customer.c_birth_month| 9 5 12 4 1 10) (rows≈10 cost≈200)
            │     │  │  └─ source catalog_sales AS catalog_sales (rows≈10 cost≈520)
            │     │  └─ filter (&& (== |cd1.cd_gender| (cast "M" <named StringView>)) (== |cd1.cd_education_status| (cast "College" <named StringView>))) (rows≈5 cost≈800)
            │     │     └─ source customer_demographics AS cd1 row-groups (&& (== |cd1.cd_education_status| (cast "College" <named StringView>)) (== |cd1.cd_gender| (cast "M" <named StringView>))) (rows≈10 cost≈400)
            │     └─ source customer_demographics AS cd2 (rows≈10 cost≈40)
            └─ filter (== |date_dim.d_year| 2001) (rows≈10 cost≈160)
               └─ source date_dim AS date_dim row-groups (== |date_dim.d_year| 2001) (rows≈10 cost≈80)
