top-sort [i_item_id asc] limit 100
└─ project (i_item_id, i_item_desc, i_current_price) (rows≈1 cost≈14K)
   └─ aggregate keys=[item.i_item_id, item.i_item_desc, item.i_current_price] (rows≈1 cost≈13.9K)
      └─ join inner [item.i_item_sk = inventory.inv_item_sk] (rows≈1 cost≈13.9K)
         ├─ join inner [catalog_sales.cs_item_sk = item.i_item_sk] emit-filter 1 from right (rows≈1 cost≈5.2K)
         │  ├─ source catalog_sales AS catalog_sales use-filter 1 keys=[catalog_sales.cs_item_sk] (rows≈10 cost≈40)
         │  └─ filter (&& (&& (<= 22 |item.i_current_price|) (<= |item.i_current_price| (+ 22 30))) (call qdb_in_list |item.i_manufact_id| 678 964 918 849)) (rows≈1 cost≈960)
         │     └─ source item AS item row-groups (&& (&& (<= 22 |item.i_current_price|) (<= |item.i_current_price| (+ 22 30))) (call qdb_in_list |item.i_manufact_id| 678 964 918 849)) (rows≈10 cost≈480)
         └─ join inner [date_dim.d_date_sk = inventory.inv_date_sk] (rows≈1 cost≈4.5K)
            ├─ filter (&& (<= (cast (cast "2001-06-02" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2001-06-02" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈1 cost≈160)
            │  └─ source date_dim AS date_dim row-groups (&& (<= (cast (cast "2001-06-02" <named StringView>) <named DATE>) |date_dim.d_date|) (<= |date_dim.d_date| (+ (cast (cast "2001-06-02" <named StringView>) <named DATE>) (: 60 i32)))) (rows≈10 cost≈80)
            └─ filter (&& (<= 100 |inventory.inv_quantity_on_hand|) (<= |inventory.inv_quantity_on_hand| 500)) (rows≈2 cost≈240)
               └─ source inventory AS inventory row-groups (&& (<= 100 |inventory.inv_quantity_on_hand|) (<= |inventory.inv_quantity_on_hand| 500)) (rows≈10 cost≈120)
