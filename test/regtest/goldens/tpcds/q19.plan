top-sort [ext_price desc, brand asc, brand_id asc, i_manufact_id asc, i_manufact asc] limit 100
└─ project (brand_id, brand, i_manufact_id, i_manufact, ext_price) (rows≈1 cost≈23.2K)
   └─ aggregate keys=[item.i_brand, item.i_brand_id, item.i_manufact_id, item.i_manufact] aggs=[sum_0=sum] (rows≈1 cost≈23.2K)
      └─ join inner [store.s_store_sk = store_sales.ss_store_sk] emit-filter 1 from right residual (!= (call substr |customer_address.ca_zip| 1 5) (call substr |store.s_zip| 1 5)) (rows≈1 cost≈23.1K)
         ├─ source store AS store use-filter 1 keys=[store.s_store_sk] (rows≈10 cost≈200)
         └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] emit-filter 2 from left (rows≈1 cost≈18.6K)
            ├─ join inner [customer_address.ca_address_sk = customer.c_current_addr_sk] emit-filter 3 from right (rows≈1 cost≈14.2K)
            │  ├─ source customer_address AS customer_address use-filter 3 keys=[customer_address.ca_address_sk] (rows≈10 cost≈200)
            │  └─ join inner [customer.c_customer_sk = store_sales.ss_customer_sk] emit-filter 4 from right (rows≈1 cost≈9.7K)
            │     ├─ source customer AS customer use-filter 4 keys=[customer.c_customer_sk] (rows≈10 cost≈80)
            │     └─ join inner [item.i_item_sk = store_sales.ss_item_sk] emit-filter 5 from left (rows≈1 cost≈5.4K)
            │        ├─ filter (== |item.i_manager_id| 7) (rows≈1 cost≈960)
            │        │  └─ source item AS item row-groups (== |item.i_manager_id| 7) (rows≈10 cost≈480)
            │        └─ source store_sales AS store_sales use-filter 5 keys=[store_sales.ss_item_sk] (rows≈10 cost≈240)
            └─ filter (&& (== |date_dim.d_moy| 11) (== |date_dim.d_year| 1999)) (rows≈10 cost≈240)
               └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 11) (== |date_dim.d_year| 1999)) use-filter 2 keys=[date_dim.d_date_sk] (rows≈10 cost≈120)
