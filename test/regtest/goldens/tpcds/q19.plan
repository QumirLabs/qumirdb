top-sort [ext_price desc, brand asc, brand_id asc, i_manufact_id asc, i_manufact asc] limit 100
└─ project (brand_id, brand, i_manufact_id, i_manufact, ext_price) (rows≈1 cost≈23.1K)
   └─ aggregate keys=[item.i_brand, item.i_brand_id, item.i_manufact_id, item.i_manufact] aggs=[sum_0=sum] (rows≈1 cost≈23.1K)
      └─ join inner [store_sales.ss_sold_date_sk = date_dim.d_date_sk] emit-filter 1 from left (rows≈1 cost≈23K)
         ├─ join inner [store_sales.ss_item_sk = item.i_item_sk] (rows≈1 cost≈18.5K)
         │  ├─ join inner [customer.c_current_addr_sk = customer_address.ca_address_sk] emit-filter 2 from left residual (!= (call substr |customer_address.ca_zip| 1 5) (call substr |store.s_zip| 1 5)) (rows≈1 cost≈13.3K)
         │  │  ├─ join inner [store_sales.ss_customer_sk = customer.c_customer_sk] emit-filter 3 from left (rows≈1 cost≈8.9K)
         │  │  │  ├─ join inner [store.s_store_sk = store_sales.ss_store_sk] (rows≈1 cost≈4.7K)
         │  │  │  │  ├─ source store AS store (rows≈10 cost≈200)
         │  │  │  │  └─ source store_sales AS store_sales (rows≈10 cost≈240)
         │  │  │  └─ source customer AS customer use-filter 3 keys=[customer.c_customer_sk] (rows≈10 cost≈80)
         │  │  └─ source customer_address AS customer_address use-filter 2 keys=[customer_address.ca_address_sk] (rows≈10 cost≈200)
         │  └─ filter (== |item.i_manager_id| 7) (rows≈1 cost≈960)
         │     └─ source item AS item row-groups (== |item.i_manager_id| 7) (rows≈10 cost≈480)
         └─ filter (&& (== |date_dim.d_moy| 11) (== |date_dim.d_year| 1999)) (rows≈10 cost≈240)
            └─ source date_dim AS date_dim row-groups (&& (== |date_dim.d_moy| 11) (== |date_dim.d_year| 1999)) use-filter 1 keys=[date_dim.d_date_sk] (rows≈10 cost≈120)
