top-sort [i_item_id asc] limit 100
└─ project (i_item_id, agg1, agg2, agg3, agg4) (rows≈1 cost≈19.7K)
   └─ aggregate keys=[item.i_item_id] aggs=[sum_0=sum, count_0=count, sum_1=sum, count_1=count, sum_2=sum, count_2=count, sum_3=sum, count_3=count] (rows≈1 cost≈19.6K)
      └─ join inner [catalog_sales.cs_bill_cdemo_sk = customer_demographics.cd_demo_sk] (rows≈1 cost≈19.5K)
         ├─ join inner [catalog_sales.cs_sold_date_sk = date_dim.d_date_sk] emit-filter 1 from left (rows≈1 cost≈14.2K)
         │  ├─ join inner [catalog_sales.cs_item_sk = item.i_item_sk] emit-filter 2 from left (rows≈1 cost≈9.8K)
         │  │  ├─ join inner [promotion.p_promo_sk = catalog_sales.cs_promo_sk] (rows≈1 cost≈5.4K)
         │  │  │  ├─ filter (|| (== |promotion.p_channel_email| (cast "N" <named StringView>)) (== |promotion.p_channel_event| (cast "N" <named StringView>))) (rows≈5 cost≈720)
         │  │  │  │  └─ source promotion AS promotion row-groups (|| (== |promotion.p_channel_email| (cast "N" <named StringView>)) (== |promotion.p_channel_event| (cast "N" <named StringView>))) (rows≈10 cost≈360)
         │  │  │  └─ source catalog_sales AS catalog_sales (rows≈10 cost≈440)
         │  │  └─ source item AS item use-filter 2 keys=[item.i_item_sk] (rows≈10 cost≈200)
         │  └─ filter (== |date_dim.d_year| 1998) (rows≈10 cost≈160)
         │     └─ source date_dim AS date_dim row-groups (== |date_dim.d_year| 1998) use-filter 1 keys=[date_dim.d_date_sk] (rows≈10 cost≈80)
         └─ filter (&& (&& (== |customer_demographics.cd_gender| (cast "F" <named StringView>)) (== |customer_demographics.cd_marital_status| (cast "W" <named StringView>))) (== |customer_demographics.cd_education_status| (cast "Primary" <named StringView>))) (rows≈1 cost≈1K)
            └─ source customer_demographics AS customer_demographics row-groups (&& (&& (== |customer_demographics.cd_education_status| (cast "Primary" <named StringView>)) (== |customer_demographics.cd_gender| (cast "F" <named StringView>))) (== |customer_demographics.cd_marital_status| (cast "W" <named StringView>))) (rows≈10 cost≈520)
