      │  │  │  │  ├─ filter (&& (== |part.p_size| 37) (call qdb_string_view_sql_like |part.p_type| (cast "%BRASS" <named StringView>))) (rows≈1 cost≈800)
      │  │  │  │  │  └─ source part AS part row-groups (&& (== |part.p_size| 37) (call qdb_string_view_sql_like |part.p_type| (cast "%BRASS" <named StringView>))) (rows≈10 cost≈400)
      │  │  │  │  └─ source partsupp AS partsupp (rows≈10 cost≈160)
      │  │  │  └─ project (__corr_0_0__, __scalar_0__) (rows≈2 cost≈13.2K)
      │  │  │     └─ aggregate keys=[partsupp_1.ps_partkey] aggs=[min_0=min] (rows≈2 cost≈13.2K)
      │  │  │        └─ join inner [supplier_1.s_suppkey = partsupp_1.ps_suppkey] emit-filter 3 from left (rows≈2 cost≈13.2K)
      │  │  │           ├─ join inner [nation_1.n_nationkey = supplier_1.s_nationkey] emit-filter 4 from left (rows≈2 cost≈8.8K)
      │  │  │           │  ├─ join inner [region_1.r_regionkey = nation_1.n_regionkey] emit-filter 5 from left (rows≈2 cost≈4.5K)
      │  │  │           │  │  ├─ filter (== |region_1.r_name| (cast "EUROPE" <named StringView>)) (rows≈1 cost≈200)
      │  │  │           │  │  │  └─ source region AS region_1 row-groups (== |region_1.r_name| (cast "EUROPE" <named StringView>)) (rows≈5 cost≈100)
      │  │  │           │  │  └─ source nation AS nation_1 use-filter 5 keys=[nation_1.n_regionkey] (rows≈10 cost≈80)
      │  │  │           │  └─ source supplier AS supplier_1 use-filter 4 keys=[supplier_1.s_nationkey] (rows≈10 cost≈80)
      │  │  │           └─ source partsupp AS partsupp_1 use-filter 3 keys=[partsupp_1.ps_suppkey] (rows≈10 cost≈160)
      │  │  └─ source supplier AS supplier use-filter 2 keys=[supplier.s_suppkey] (rows≈10 cost≈800)
