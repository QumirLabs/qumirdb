sort [supp_nation asc, cust_nation asc, l_year asc]
└─ project (supp_nation, cust_nation, l_year, revenue) (rows≈5 cost≈24.5K)
   └─ aggregate keys=[shipping.supp_nation, shipping.cust_nation, shipping.l_year] aggs=[sum_0=sum] (rows≈5 cost≈24.3K)
      └─ project (shipping.supp_nation, shipping.cust_nation, shipping.l_year, shipping.volume) (rows≈5 cost≈24.1K)
         └─ project (supp_nation, cust_nation, l_year, volume) (rows≈5 cost≈23.9K)
            └─ join inner [customer.c_custkey = orders.o_custkey] residual (|| (&& (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>))) (&& (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>)))) (rows≈5 cost≈23.7K)
               ├─ join inner [n2.n_nationkey = customer.c_nationkey] (rows≈5 cost≈4.8K)
               │  ├─ filter (|| (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>))) (rows≈5 cost≈400)
               │  │  └─ source nation AS n2 row-groups (|| (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>))) (rows≈10 cost≈200)
               │  └─ source customer AS customer (rows≈10 cost≈80)
               └─ join inner [supplier.s_suppkey = lineitem.l_suppkey] (rows≈5 cost≈14.3K)
                  ├─ join inner [n1.n_nationkey = supplier.s_nationkey] (rows≈5 cost≈4.8K)
                  │  ├─ filter (|| (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>))) (rows≈5 cost≈400)
                  │  │  └─ source nation AS n1 row-groups (|| (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>))) (rows≈10 cost≈200)
                  │  └─ source supplier AS supplier (rows≈10 cost≈80)
                  └─ join inner [orders.o_orderkey = lineitem.l_orderkey] (rows≈7 cost≈5.1K)
                     ├─ source orders AS orders (rows≈10 cost≈80)
                     └─ filter (&& (<= (: 9131 i32) |lineitem.l_shipdate|) (<= |lineitem.l_shipdate| (: 9861 i32))) (rows≈7 cost≈560)
                        └─ source lineitem AS lineitem row-groups (&& (<= (: 9131 i32) |lineitem.l_shipdate|) (<= |lineitem.l_shipdate| (: 9861 i32))) (rows≈10 cost≈280)
