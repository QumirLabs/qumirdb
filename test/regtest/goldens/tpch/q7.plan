sort [supp_nation asc, cust_nation asc, l_year asc]
└─ project (supp_nation, cust_nation, l_year, revenue) (rows≈1 cost≈22.8K)
   └─ aggregate keys=[shipping.supp_nation, shipping.cust_nation, shipping.l_year] aggs=[sum_0=sum] (rows≈1 cost≈22.7K)
      └─ project (shipping.supp_nation, shipping.cust_nation, shipping.l_year, shipping.volume) (rows≈1 cost≈22.7K)
         └─ join inner [supplier.s_nationkey = n1.n_nationkey] residual (|| (&& (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>))) (&& (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>)))) (rows≈1 cost≈22.6K)
            ├─ join inner [lineitem.l_suppkey = supplier.s_suppkey] emit-filter 1 from left (rows≈1 cost≈18K)
            │  ├─ join inner [orders.o_orderkey = lineitem.l_orderkey] emit-filter 2 from left (rows≈2 cost≈13.7K)
            │  │  ├─ join inner [n2.n_nationkey = customer.c_nationkey] (rows≈1 cost≈8.9K)
            │  │  │  ├─ filter (|| (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>))) (rows≈5 cost≈400)
            │  │  │  │  └─ source nation AS n2 row-groups (|| (== |n2.n_name| (cast "UNITED KINGDOM" <named StringView>)) (== |n2.n_name| (cast "FRANCE" <named StringView>))) (rows≈10 cost≈200)
            │  │  │  └─ join inner [customer.c_custkey = orders.o_custkey] (rows≈1 cost≈4.4K)
            │  │  │     ├─ source customer AS customer (rows≈10 cost≈80)
            │  │  │     └─ source orders AS orders (rows≈10 cost≈80)
            │  │  └─ filter (&& (<= (: 9131 i32) |lineitem.l_shipdate|) (<= |lineitem.l_shipdate| (: 9861 i32))) (rows≈7 cost≈560)
            │  │     └─ source lineitem AS lineitem row-groups (&& (<= (: 9131 i32) |lineitem.l_shipdate|) (<= |lineitem.l_shipdate| (: 9861 i32))) use-filter 2 keys=[lineitem.l_orderkey] (rows≈10 cost≈280)
            │  └─ source supplier AS supplier use-filter 1 keys=[supplier.s_suppkey] (rows≈10 cost≈80)
            └─ filter (|| (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>))) (rows≈5 cost≈400)
               └─ source nation AS n1 row-groups (|| (== |n1.n_name| (cast "FRANCE" <named StringView>)) (== |n1.n_name| (cast "UNITED KINGDOM" <named StringView>))) (rows≈10 cost≈200)
