sort [nation asc, o_year desc]
└─ project (nation, o_year, sum_profit) (rows≈1 cost≈22.5K)
   └─ aggregate keys=[profit.nation, profit.o_year] aggs=[sum_0=sum] (rows≈1 cost≈22.5K)
      └─ project (profit.nation, profit.o_year, profit.amount) (rows≈1 cost≈22.4K)
         └─ join inner [nation.n_nationkey = supplier.s_nationkey] emit-filter 1 from right (rows≈1 cost≈22.4K)
            ├─ source nation AS nation use-filter 1 keys=[nation.n_nationkey] (rows≈10 cost≈200)
            └─ join inner [supplier.s_suppkey = partsupp.ps_suppkey, lineitem.l_partkey = partsupp.ps_partkey] emit-filter 2 from left (rows≈1 cost≈18K)
               ├─ join inner [lineitem.l_suppkey = supplier.s_suppkey] emit-filter 3 from left (rows≈1 cost≈13.5K)
               │  ├─ join inner [orders.o_orderkey = lineitem.l_orderkey] emit-filter 4 from right (rows≈1 cost≈9.2K)
               │  │  ├─ source orders AS orders use-filter 4 keys=[orders.o_orderkey] (rows≈10 cost≈80)
               │  │  └─ join inner [lineitem.l_partkey = part.p_partkey] emit-filter 5 from right (rows≈1 cost≈5K)
               │  │     ├─ source lineitem AS lineitem use-filter 5 keys=[lineitem.l_partkey] (rows≈10 cost≈360)
               │  │     └─ filter (call qdb_string_view_sql_like |part.p_name| (cast "%turquoise%" <named StringView>)) (rows≈1 cost≈400)
               │  │        └─ source part AS part row-groups (call qdb_string_view_sql_like |part.p_name| (cast "%turquoise%" <named StringView>)) (rows≈10 cost≈200)
               │  └─ source supplier AS supplier use-filter 3 keys=[supplier.s_suppkey] (rows≈10 cost≈80)
               └─ source partsupp AS partsupp use-filter 2 keys=[partsupp.ps_suppkey, partsupp.ps_partkey] (rows≈10 cost≈160)
