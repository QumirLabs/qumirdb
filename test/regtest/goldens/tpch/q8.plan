sort [o_year asc]
└─ project (o_year, mkt_share) (rows≈1 cost≈31.1K)
   └─ aggregate keys=[o_year] aggs=[sum_0=sum, sum_1=sum] (rows≈1 cost≈31.1K)
      └─ project (o_year, arg_0, volume) (rows≈1 cost≈31.1K)
         └─ project (all_nations.o_year, all_nations.volume, all_nations.nation) (rows≈1 cost≈31.1K)
            └─ join inner [supplier.s_nationkey = n2.n_nationkey] emit-filter 1 from left (rows≈1 cost≈31K)
               ├─ join inner [lineitem.l_suppkey = supplier.s_suppkey] emit-filter 2 from left (rows≈1 cost≈26.6K)
               │  ├─ join inner [n1.n_nationkey = customer.c_nationkey] (rows≈1 cost≈22.3K)
               │  │  ├─ join inner [region.r_regionkey = n1.n_regionkey] emit-filter 3 from left (rows≈2 cost≈4.5K)
               │  │  │  ├─ filter (== |region.r_name| (cast "EUROPE" <named StringView>)) (rows≈1 cost≈200)
               │  │  │  │  └─ source region AS region row-groups (== |region.r_name| (cast "EUROPE" <named StringView>)) (rows≈5 cost≈100)
               │  │  │  └─ source nation AS n1 use-filter 3 keys=[n1.n_regionkey] (rows≈10 cost≈80)
               │  │  └─ join inner [customer.c_custkey = orders.o_custkey] emit-filter 4 from right (rows≈1 cost≈13.6K)
               │  │     ├─ source customer AS customer use-filter 4 keys=[customer.c_custkey] (rows≈10 cost≈80)
               │  │     └─ join inner [orders.o_orderkey = lineitem.l_orderkey] (rows≈1 cost≈9.3K)
               │  │        ├─ filter (&& (<= (: 9131 i32) |orders.o_orderdate|) (<= |orders.o_orderdate| (: 9861 i32))) (rows≈5 cost≈240)
               │  │        │  └─ source orders AS orders row-groups (&& (<= (: 9131 i32) |orders.o_orderdate|) (<= |orders.o_orderdate| (: 9861 i32))) (rows≈10 cost≈120)
               │  │        └─ join inner [lineitem.l_partkey = part.p_partkey] emit-filter 5 from right (rows≈1 cost≈4.9K)
               │  │           ├─ source lineitem AS lineitem use-filter 5 keys=[lineitem.l_partkey] (rows≈10 cost≈280)
               │  │           └─ filter (== |part.p_type| (cast "PROMO POLISHED BRASS" <named StringView>)) (rows≈1 cost≈400)
               │  │              └─ source part AS part row-groups (== |part.p_type| (cast "PROMO POLISHED BRASS" <named StringView>)) (rows≈10 cost≈200)
               │  └─ source supplier AS supplier use-filter 2 keys=[supplier.s_suppkey] (rows≈10 cost≈80)
               └─ source nation AS n2 use-filter 1 keys=[n2.n_nationkey] (rows≈10 cost≈200)
