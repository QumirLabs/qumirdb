project (promo_revenue) (rows≈1 cost≈5.3K)
└─ aggregate keys=[__group__] aggs=[sum_0=sum, sum_1=sum] (rows≈1 cost≈5.3K)
   └─ project (arg_0, arg_1, __group__) (rows≈5 cost≈5.2K)
      └─ join inner [part.p_partkey = lineitem.l_partkey] (rows≈5 cost≈5.1K)
         ├─ source part AS part (rows≈10 cost≈200)
         └─ filter (&& (>= |lineitem.l_shipdate| (: 8460 i32)) (< |lineitem.l_shipdate| (+ (: 8460 i32) (: 30 i32)))) (rows≈5 cost≈480)
            └─ source lineitem AS lineitem row-groups (&& (>= |lineitem.l_shipdate| (: 8460 i32)) (< |lineitem.l_shipdate| (+ (: 8460 i32) (: 30 i32)))) (rows≈10 cost≈240)
