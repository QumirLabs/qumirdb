(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join (rel source "customer") (rel source "orders") () (inner))
              (rel source "lineitem")
              ()
              (inner))
            (rel project
              (rel filter
                (rel aggregate (rel source "lineitem") (keys l_orderkey) (agg sum_0 sum l_quantity))
                (> sum_0 315))
              (__qdb_in__l_orderkey l_orderkey))
            ()
            (left_semi)
            (residual (== o_orderkey __qdb_in__l_orderkey)))
          (&& (== c_custkey o_custkey) (== o_orderkey l_orderkey)))
        (keys c_name c_custkey o_orderkey o_orderdate o_totalprice)
        (agg sum_0 sum l_quantity))
      (c_name c_name)
      (c_custkey c_custkey)
      (o_orderkey o_orderkey)
      (o_orderdate o_orderdate)
      (o_totalprice o_totalprice)
      (col5 sum_0))
    (o_totalprice desc nulls-default)
    (o_orderdate asc nulls-default))
  (limit 100))
