sort [revenue desc]
└─ project (n_name, revenue) (rows≈1 cost≈22.1K)
   └─ aggregate keys=[nation.n_name] aggs=[sum_0=sum] (rows≈1 cost≈22.1K)
      └─ project (nation.n_name, arg_0) (rows≈1 cost≈22.1K)
         └─ join inner [lineitem.l_orderkey = orders.o_orderkey, supplier.s_nationkey = customer.c_nationkey] (rows≈1 cost≈22K)
            ├─ join inner [region.r_regionkey = nation.n_regionkey] (rows≈1 cost≈13.3K)
            │  ├─ filter (== |region.r_name| (cast "MIDDLE EAST" <named StringView>)) (rows≈1 cost≈200)
            │  │  └─ source region AS region row-groups (== |region.r_name| (cast "MIDDLE EAST" <named StringView>)) (rows≈5 cost≈100)
            │  └─ join inner [nation.n_nationkey = supplier.s_nationkey] emit-filter 1 from right (rows≈1 cost≈9K)
            │     ├─ source nation AS nation use-filter 1 keys=[nation.n_nationkey] (rows≈10 cost≈240)
            │     └─ join inner [supplier.s_suppkey = lineitem.l_suppkey] (rows≈1 cost≈4.5K)
            │        ├─ source supplier AS supplier (rows≈10 cost≈80)
            │        └─ source lineitem AS lineitem (rows≈10 cost≈240)
            └─ join inner [orders.o_custkey = customer.c_custkey] (rows≈1 cost≈4.5K)
               ├─ filter (&& (>= |orders.o_orderdate| (: 9131 i32)) (< |orders.o_orderdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈2 cost≈240)
               │  └─ source orders AS orders row-groups (&& (>= |orders.o_orderdate| (: 9131 i32)) (< |orders.o_orderdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈10 cost≈120)
               └─ source customer AS customer (rows≈10 cost≈80)
