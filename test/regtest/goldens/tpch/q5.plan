sort [revenue desc]
└─ project (n_name, revenue) (rows≈1 cost≈22.4K)
   └─ aggregate keys=[n_name] aggs=[sum_0=sum] (rows≈1 cost≈22.3K)
      └─ project (n_name, arg_0) (rows≈1 cost≈22.3K)
         └─ join inner [orders.o_orderkey = lineitem.l_orderkey, supplier.s_suppkey = lineitem.l_suppkey] (rows≈1 cost≈22.3K)
            ├─ join inner [supplier.s_nationkey = customer.c_nationkey] (rows≈2 cost≈17.8K)
            │  ├─ join inner [nation.n_nationkey = supplier.s_nationkey] emit-filter 1 from left (rows≈2 cost≈9K)
            │  │  ├─ join inner [region.r_regionkey = nation.n_regionkey] emit-filter 2 from left (rows≈2 cost≈4.7K)
            │  │  │  ├─ filter (== |region.r_name| (cast "MIDDLE EAST" <named StringView>)) (rows≈1 cost≈200)
            │  │  │  │  └─ source region AS region row-groups (== |region.r_name| (cast "MIDDLE EAST" <named StringView>)) (rows≈5 cost≈100)
            │  │  │  └─ source nation AS nation use-filter 2 keys=[nation.n_regionkey] (rows≈10 cost≈240)
            │  │  └─ source supplier AS supplier use-filter 1 keys=[supplier.s_nationkey] (rows≈10 cost≈80)
            │  └─ join inner [orders.o_custkey = customer.c_custkey] (rows≈2 cost≈4.5K)
            │     ├─ filter (&& (>= |orders.o_orderdate| (: 9131 i32)) (< |orders.o_orderdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈2 cost≈240)
            │     │  └─ source orders AS orders row-groups (&& (>= |orders.o_orderdate| (: 9131 i32)) (< |orders.o_orderdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈10 cost≈120)
            │     └─ source customer AS customer (rows≈10 cost≈80)
            └─ source lineitem AS lineitem (rows≈10 cost≈240)
