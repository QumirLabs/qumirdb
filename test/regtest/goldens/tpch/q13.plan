(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel project
          (rel aggregate
            (rel join
              (rel source "customer")
              (rel source "orders")
              ()
              (left)
              (residual (&& (== c_custkey o_custkey)
                (! (call qdb_string_view_sql_like o_comment (cast "%special%packages%" <named StringView>))))))
            (keys c_custkey)
            (agg count_0 count o_orderkey))
          (c_custkey c_custkey)
          (c_count count_0))
        (|c_orders.c_custkey| c_custkey)
        (|c_orders.c_count| c_count))
      (keys c_count)
      (agg count_0 count))
    (c_count c_count)
    (custdist count_0))
  (custdist desc nulls-default)
  (c_count desc nulls-default))
