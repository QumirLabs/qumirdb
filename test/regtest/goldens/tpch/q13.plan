sort [custdist desc, c_count desc]
└─ project (c_count, custdist) (rows≈10 cost≈5.6K)
   └─ aggregate keys=[c_orders.c_count] aggs=[count_0=count] (rows≈10 cost≈5.4K)
      └─ project (c_orders.c_count) (rows≈10 cost≈5.3K)
         └─ project (c_count) (rows≈10 cost≈5.2K)
            └─ aggregate keys=[customer.c_custkey] aggs=[count_0=count] (rows≈10 cost≈5.1K)
               └─ join left [customer.c_custkey = orders.o_custkey] (rows≈10 cost≈5K)
                  ├─ source customer AS customer (rows≈10 cost≈40)
                  └─ filter (! (call qdb_string_view_sql_like |orders.o_comment| (cast "%special%packages%" <named StringView>))) (rows≈9 cost≈480)
                     └─ source orders AS orders row-groups (! (call qdb_string_view_sql_like |orders.o_comment| (cast "%special%packages%" <named StringView>))) (rows≈10 cost≈240)
