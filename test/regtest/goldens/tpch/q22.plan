(rel sort
  (rel project
    (rel aggregate
      (rel project
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel source "customer")
                (rel project
                  (rel aggregate
                    (rel project
                      (rel filter
                        (rel source "customer")
                        (&& (> c_acctbal 0.0)
                          (call
                            qdb_in_list
                            (call qdb_substring c_phone (cast 1 i32) (cast 2 i32))
                            (cast "27" <named StringView>)
                            (cast "20" <named StringView>)
                            (cast "22" <named StringView>)
                            (cast "34" <named StringView>)
                            (cast "29" <named StringView>)
                            (cast "23" <named StringView>)
                            (cast "17" <named StringView>))))
                      (c_acctbal c_acctbal)
                      (__group__ 1))
                    (keys __group__)
                    (agg sum_0 sum c_acctbal)
                    (agg count_1 count c_acctbal))
                  (__scalar_0__ (/ sum_0 (cast count_1 f64))))
                ()
                (inner))
              (rel source "orders")
              ()
              (left_anti)
              (residual (== o_custkey c_custkey)))
            (&& (call
                qdb_in_list
                (call qdb_substring c_phone (cast 1 i32) (cast 2 i32))
                (cast "27" <named StringView>)
                (cast "20" <named StringView>)
                (cast "22" <named StringView>)
                (cast "34" <named StringView>)
                (cast "29" <named StringView>)
                (cast "23" <named StringView>)
                (cast "17" <named StringView>))
              (> c_acctbal __scalar_0__)))
          (cntrycode (call qdb_substring c_phone (cast 1 i32) (cast 2 i32)))
          (c_acctbal c_acctbal))
        (|custsale.cntrycode| cntrycode)
        (|custsale.c_acctbal| c_acctbal))
      (keys cntrycode)
      (agg count_0 count)
      (agg sum_1 sum c_acctbal))
    (cntrycode cntrycode)
    (numcust count_0)
    (totacctbal sum_1))
  (cntrycode asc nulls-default))
