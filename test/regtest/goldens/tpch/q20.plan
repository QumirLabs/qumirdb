(rel sort
  (rel project
    (rel filter
      (rel join
        (rel join (rel source "supplier") (rel source "nation") () (inner))
        (rel project
          (rel filter
            (rel join
              (rel join
                (rel source "partsupp")
                (rel project
                  (rel filter
                    (rel source "part")
                    (call qdb_string_view_sql_like p_name (cast "thistle%" <named StringView>)))
                  (__qdb_in__p_partkey p_partkey))
                ()
                (left_semi)
                (residual (== ps_partkey __qdb_in__p_partkey)))
              (rel project
                (rel aggregate
                  (rel project
                    (rel filter
                      (rel source "lineitem")
                      (&& (&& (&& (== l_partkey ps_partkey) (== l_suppkey ps_suppkey)) (>= l_shipdate (: 9131 i32)))
                        (< l_shipdate (+ (: 9131 i32) (: 365 i32)))))
                    (l_quantity l_quantity)
                    (__group__ 1))
                  (keys __group__)
                  (agg sum_0 sum l_quantity))
                (__scalar_0__ (* 0.5 sum_0)))
              ()
              (inner))
            (> ps_availqty __scalar_0__))
          (__qdb_in__ps_suppkey ps_suppkey))
        ()
        (left_semi)
        (residual (== s_suppkey __qdb_in__ps_suppkey)))
      (&& (== s_nationkey n_nationkey) (== n_name (cast "PERU" <named StringView>))))
    (s_name s_name)
    (s_address s_address))
  (s_name asc nulls-default))
