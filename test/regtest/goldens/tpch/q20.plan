sort [s_name asc]
└─ project (s_name, s_address) (rows≈1 cost≈18.6K)
   └─ join left_semi [supplier.s_suppkey = __qdb_in__] (rows≈1 cost≈18.6K)
      ├─ join inner [nation.n_nationkey = supplier.s_nationkey] emit-filter 1 from left (rows≈1 cost≈5K)
      │  ├─ filter (== |nation.n_name| (cast "PERU" <named StringView>)) (rows≈1 cost≈400)
      │  │  └─ source nation AS nation row-groups (== |nation.n_name| (cast "PERU" <named StringView>)) (rows≈10 cost≈200)
      │  └─ source supplier AS supplier use-filter 1 keys=[supplier.s_nationkey] (rows≈10 cost≈400)
      └─ project (__qdb_in__) (rows≈1 cost≈9.4K)
         └─ filter (> |partsupp.ps_availqty| __scalar_0__) (rows≈1 cost≈9.4K)
            └─ join left [partsupp.ps_partkey = __corr_0_0__, partsupp.ps_suppkey = __corr_0_1__] (rows≈3 cost≈9.3K)
               ├─ join left_semi [partsupp.ps_partkey = __qdb_in__] (rows≈3 cost≈4.7K)
               │  ├─ source partsupp AS partsupp (rows≈10 cost≈120)
               │  └─ project (__qdb_in__) (rows≈1 cost≈404)
               │     └─ filter (call qdb_string_view_sql_like |part.p_name| (cast "thistle%" <named StringView>)) (rows≈1 cost≈400)
               │        └─ source part AS part row-groups (call qdb_string_view_sql_like |part.p_name| (cast "thistle%" <named StringView>)) (rows≈10 cost≈200)
               └─ project (__corr_0_0__, __corr_0_1__, __scalar_0__) (rows≈1 cost≈432)
                  └─ aggregate keys=[lineitem.l_partkey, lineitem.l_suppkey] aggs=[sum_0=sum] (rows≈1 cost≈416)
                     └─ filter (&& (>= |lineitem.l_shipdate| (: 9131 i32)) (< |lineitem.l_shipdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈1 cost≈400)
                        └─ source lineitem AS lineitem row-groups (&& (>= |lineitem.l_shipdate| (: 9131 i32)) (< |lineitem.l_shipdate| (+ (: 9131 i32) (: 365 i32)))) (rows≈10 cost≈200)
