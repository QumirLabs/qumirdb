sort [supplier_cnt desc, p_brand asc, p_type asc, p_size asc]
└─ project (p_brand, p_type, p_size, supplier_cnt) (rows≈4 cost≈10.5K)
   └─ aggregate keys=[part.p_brand, part.p_type, part.p_size] aggs=[count_0=count] (rows≈4 cost≈10.3K)
      └─ aggregate keys=[part.p_brand, part.p_type, part.p_size, partsupp.ps_suppkey] (rows≈4 cost≈10.2K)
         └─ join left_anti [partsupp.ps_suppkey = __qdb_in__s_suppkey] (rows≈4 cost≈10K)
            ├─ join inner [part.p_partkey = partsupp.ps_partkey] (rows≈5 cost≈5.3K)
            │  ├─ filter (&& (&& (!= |part.p_brand| (cast "Brand#54" <named StringView>)) (! (call qdb_string_view_sql_like |part.p_type| (cast "PROMO ANODIZED%" <named StringView>)))) (call qdb_in_list |part.p_size| 24 47 25 36 22 26 49 40)) (rows≈5 cost≈800)
            │  │  └─ source part AS part row-groups (&& (&& (!= |part.p_brand| (cast "Brand#54" <named StringView>)) (call qdb_in_list |part.p_size| 24 47 25 36 22 26 49 40)) (! (call qdb_string_view_sql_like |part.p_type| (cast "PROMO ANODIZED%" <named StringView>)))) (rows≈10 cost≈400)
            │  └─ source partsupp AS partsupp (rows≈10 cost≈80)
            └─ project (__qdb_in__s_suppkey) (rows≈1 cost≈404)
               └─ filter (call qdb_string_view_sql_like |supplier.s_comment| (cast "%Customer%Complaints%" <named StringView>)) (rows≈1 cost≈400)
                  └─ source supplier AS supplier row-groups (call qdb_string_view_sql_like |supplier.s_comment| (cast "%Customer%Complaints%" <named StringView>)) (rows≈10 cost≈200)
