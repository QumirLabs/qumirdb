(query
  (select
    (select-list
      (item as promo_revenue
        (/ (* 100.0
            (call
              sum
              (if
                (call qdb_is_true (call qdb_string_view_sql_like p_type (cast "PROMO%" <named StringView>)))
                (* l_extendedprice (- 1 l_discount))
                0)))
          (call sum (* l_extendedprice (- 1 l_discount))))
      )
    )
    (from
      (table lineitem)
      (table part)
    )
    (where
      (&& (&& (== l_partkey p_partkey) (>= l_shipdate (: 8460 <named DATE [i32]>)))
        (< l_shipdate (: 8491 <named DATE [i32]>)))
    )
  )
)
