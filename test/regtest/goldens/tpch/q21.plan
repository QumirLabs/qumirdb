top-sort [numwait desc, s_name asc] limit 100
└─ project (s_name, numwait) (rows≈1 cost≈22.8K)
   └─ aggregate keys=[supplier.s_name] aggs=[count_0=count] (rows≈1 cost≈22.8K)
      └─ join left_anti [orders.o_orderkey = l3.l_orderkey] residual (!= |l3.l_suppkey| |l1.l_suppkey|) (rows≈1 cost≈22.7K)
         ├─ join left_semi [orders.o_orderkey = l2.l_orderkey] residual (!= |l2.l_suppkey| |l1.l_suppkey|) (rows≈1 cost≈18.2K)
         │  ├─ join inner [l1.l_orderkey = orders.o_orderkey] (rows≈1 cost≈13.9K)
         │  │  ├─ join inner [supplier.s_suppkey = l1.l_suppkey] (rows≈1 cost≈9.3K)
         │  │  │  ├─ join inner [nation.n_nationkey = supplier.s_nationkey] emit-filter 1 from left (rows≈1 cost≈4.8K)
         │  │  │  │  ├─ filter (== |nation.n_name| (cast "IRAQ" <named StringView>)) (rows≈1 cost≈400)
         │  │  │  │  │  └─ source nation AS nation row-groups (== |nation.n_name| (cast "IRAQ" <named StringView>)) (rows≈10 cost≈200)
         │  │  │  │  └─ source supplier AS supplier use-filter 1 keys=[supplier.s_nationkey] (rows≈10 cost≈240)
         │  │  │  └─ filter (> |l1.l_receiptdate| |l1.l_commitdate|) (rows≈5 cost≈320)
         │  │  │     └─ source lineitem AS l1 row-groups (> |l1.l_receiptdate| |l1.l_commitdate|) (rows≈10 cost≈160)
         │  │  └─ filter (== |orders.o_orderstatus| (cast "F" <named StringView>)) (rows≈5 cost≈400)
         │  │     └─ source orders AS orders row-groups (== |orders.o_orderstatus| (cast "F" <named StringView>)) (rows≈10 cost≈200)
         │  └─ source lineitem AS l2 (rows≈10 cost≈80)
         └─ filter (> |l3.l_receiptdate| |l3.l_commitdate|) (rows≈5 cost≈320)
            └─ source lineitem AS l3 row-groups (> |l3.l_receiptdate| |l3.l_commitdate|) (rows≈10 cost≈160)
