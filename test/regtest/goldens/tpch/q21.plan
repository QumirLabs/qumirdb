(rel limit
  (rel sort
    (rel project
      (rel aggregate
        (rel filter
          (rel join
            (rel join
              (rel join
                (rel join
                  (rel join (rel source "supplier") (rel source "lineitem" "l1") () (inner))
                  (rel source "orders")
                  ()
                  (inner))
                (rel source "nation")
                ()
                (inner))
              (rel source "lineitem" "l2")
              ()
              (left_semi)
              (residual (&& (== |l2.l_orderkey| |l1.l_orderkey|) (!= |l2.l_suppkey| |l1.l_suppkey|))))
            (rel source "lineitem" "l3")
            ()
            (left_anti)
            (residual (&& (&& (== |l3.l_orderkey| |l1.l_orderkey|) (!= |l3.l_suppkey| |l1.l_suppkey|))
              (> |l3.l_receiptdate| |l3.l_commitdate|))))
          (&& (&& (&& (&& (&& (== s_suppkey |l1.l_suppkey|) (== o_orderkey |l1.l_orderkey|))
                  (== o_orderstatus (cast "F" <named StringView>)))
                (> |l1.l_receiptdate| |l1.l_commitdate|))
              (== s_nationkey n_nationkey))
            (== n_name (cast "IRAQ" <named StringView>))))
        (keys s_name)
        (agg count_0 count))
      (s_name s_name)
      (numwait count_0))
    (numwait desc nulls-default)
    (s_name asc nulls-default))
  (limit 100))
