sort [ck asc]
└─ project (grp, ck, total, n, m) (rows≈2 cost≈11K)
   └─ join left [cs.ck = os.ok, cs.grp = os.flag] emit-filter 1 from left (rows≈2 cost≈10.9K)
      ├─ join right [ps.pk = cs.ck, ps.pv = cs.grp] (rows≈2 cost≈5.1K)
      │  ├─ project (ps.pv, ps.pk, ps.m) (rows≈2 cost≈336)
      │  │  └─ project (pv, pk, m) (rows≈2 cost≈288)
      │  │     └─ aggregate keys=[p.pv, p.pk] aggs=[count_0=count] (rows≈2 cost≈240)
      │  │        └─ filter (== |p.pv| 1) (rows≈2 cost≈192)
      │  │           └─ source p AS p row-groups (== |p.pv| 1) (rows≈6 cost≈96)
      │  └─ project (cs.grp, cs.ck, cs.total) (rows≈2 cost≈528)
      │     └─ project (grp, ck, total) (rows≈2 cost≈480)
      │        └─ aggregate keys=[c.grp, c.ck] aggs=[sum_0=sum] (rows≈2 cost≈432)
      │           └─ filter (== |c.grp| 1) (rows≈2 cost≈384)
      │              └─ source c AS c row-groups (== |c.grp| 1) (rows≈8 cost≈192)
      └─ project (os.flag, os.ok, os.n) (rows≈10 cost≈1.4K)
         └─ project (flag, ok, n) (rows≈10 cost≈1.1K)
            └─ aggregate keys=[o.flag, o.ok] aggs=[count_0=count] (rows≈10 cost≈880)
               └─ filter (== |o.flag| 1) (rows≈10 cost≈640)
                  └─ source o AS o row-groups (== |o.flag| 1) use-filter 1 keys=[o.ok, o.flag] (rows≈20 cost≈320)
