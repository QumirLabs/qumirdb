sort [s desc, grp asc]
└─ project (grp, s, hi) (rows≈5 cost≈860)
   └─ filter (> (cast sum_0 f32) 0.29999999999999999) (rows≈5 cost≈800)
      └─ aggregate keys=[grp] aggs=[sum_0=sum, max_0=max] (rows≈10 cost≈600)
         └─ project (grp, q.g) (rows≈10 cost≈400)
            └─ project (q.id, q.g) (rows≈10 cost≈320)
               └─ filter (> |t.id| 1) (rows≈10 cost≈240)
                  └─ source t AS t row-groups (> |t.id| 1) (rows≈10 cost≈120)
