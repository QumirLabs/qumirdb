[libfuzzer]
# Compiling the VM kernels of a wide TPC-DS or ClickBench query under ASan takes
# seconds and up to 2 GB; a single huge allocation still fails at malloc_limit_mb.
timeout = 100
rss_limit_mb = 4096
malloc_limit_mb = 2560
# libFuzzer replays the whole corpus before it mutates, and long queries compile
# slowly; 93% of the stored corpus is under 8 KB.
max_len = 8192
