#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    if ! getent passwd qumirdb-daemon >/dev/null; then
        adduser --system --group --no-create-home \
                --home /nonexistent \
                --gecos "QumirDB cluster node daemon" \
                qumirdb-daemon
    fi
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
